{
  "$self": "https://contracts.bytedesk.ai/agent-delivery/openapi/v1/agent-delivery.openapi.json",
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "ByteDesk Agent Delivery API",
    "version": "1.0.0",
    "description": "Consumer-neutral, headless delivery API. Exact JSON Schemas in the signed offline contract bundle are normative; this document is a projection. Events and clients cannot write desired state."
  },
  "servers": [
    {
      "url": "https://{authority}",
      "variables": {
        "authority": {
          "default": "agent-delivery.invalid",
          "description": "Deployment-selected authenticated API authority; the example default is intentionally non-routable."
        }
      }
    }
  ],
  "tags": [
    {
      "name": "public",
      "description": "Tenant-free exact-digest reads."
    },
    {
      "name": "actions",
      "description": "Durable asynchronous work."
    },
    {
      "name": "installations",
      "description": "Consumer installation and binding state."
    },
    {
      "name": "promotion",
      "description": "Promotion Coordinator command and status surface."
    },
    {
      "name": "reconciliation",
      "description": "Target-scoped host observations."
    },
    {
      "name": "evidence",
      "description": "Receipts and verification results."
    }
  ],
