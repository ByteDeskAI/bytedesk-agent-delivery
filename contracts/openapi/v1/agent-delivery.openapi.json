  "components": {
    "securitySchemes": {
      "consumerBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "consumer-issued short-lived sender-bound token",
        "description": "The deployment Authentication Adapter validates issuer, audience, expiry, sender/consumer binding, and operation scope."
      },
      "targetReconcilerBearer": {
        "type": "mutualTLS",
        "description": "Certificate-bound identity scoped to exactly one consumer and runtime target. It can read desired state and append observations only."
      },
      "capabilityVerifierMtls": {
        "type": "mutualTLS",
        "description": "Purpose-separated consumer capability-verifier certificate identity. It may append nonce-bound capability evidence for its exact consumer and target only; it cannot submit commands, append host observations, write desired state, or authorize promotion."
      }
    },
    "parameters": {
      "ActionId": {
        "name": "actionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "CandidateId": {
        "name": "candidateId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "CatalogId": {
        "name": "catalogId",
        "in": "path",
        "required": true,
