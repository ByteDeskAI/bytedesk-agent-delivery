          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/CatalogIndex"
          },
          "304": {
            "description": "The caller already has the exact current representation."
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
