    "/v1/commands": {
      "post": {
        "operationId": "submitCommand",
        "summary": "Submit one closed typed command",
        "description": "The command discriminator selects one schema-defined source validation, render, import, installation, update-proposal, promotion, forward-recovery, cancellation, or publication request. Every command submission requires a short-lived authenticated caller; source_validate and render may use only a public-purpose scope and tenant-free inputs, while every private command requires exact consumer and operation scope selected from the validated command discriminator. If-Match or If-None-Match and the schema precondition must agree whenever the command mutates an aggregate. The API routes promotion commands to the sole logical writer; accepting a command never makes the caller or event stream a desired-state writer.",
        "tags": [
          "actions",
          "promotion"
        ],
        "security": [
          {
            "consumerBearer": []
          }
        ],
        "x-bytedesk-command-authorization": {
          "discriminator": "command",
          "publicPurposeCommands": [
            "source_validate",
            "render"
          ],
          "privateDefault": "require-exact-consumer-and-operation-scope",
          "unknownCommand": "deny"
        },
        "x-bytedesk-conditional-request": {
          "discriminator": "precondition.kind",
          "notApplicableCommands": [
            "source_validate",
            "render"
          ],
          "absent": {
            "requiredHeader": "If-None-Match",
            "requiredValue": "*",
            "forbiddenHeader": "If-Match"
          },
          "match": {
            "requiredHeader": "If-Match",
            "requiredValueFrom": "precondition.digest",
            "forbiddenHeader": "If-None-Match"
          },
          "missingOrConflicting": "deny"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CanonicalRequestDigest"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/AcceptedAction"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
