    "/v1/targets/{targetId}/events": {
      "get": {
        "operationId": "watchTargetEvents",
        "summary": "Watch target-scoped delivery notifications",
        "description": "Authenticated HTTP/2 SSE notification stream. Last-Event-ID resumes at-least-once delivery by exact event ID. Notifications never replace an authoritative target-state read. A rejected or detected cursor gap stops projection and requires resynchronizeTargetEvents before reconnecting. Heartbeats and disconnects have no control-plane effect: durable actions continue until terminal or an explicit authenticated cancellation command succeeds.",
        "tags": [
          "reconciliation",
          "actions"
        ],
        "security": [
          {
            "targetReconcilerBearer": []
          }
        ],
        "x-bytedesk-port-operations": [
          "bytedesk.port.desired-state-store/1#watch-target-state",
          "bytedesk.port.control-plane-api-events/1#subscribe-events"
        ],
        "x-bytedesk-sse": {
          "profile": "bytedesk.target-events-sse/1",
          "itemMediaType": "application/cloudevents+json",
          "delivery": "at-least-once",
          "ordering": "per-aggregate-sequence",
          "resumeHeader": "Last-Event-ID",
          "eventId": "CloudEvent.id",
          "heartbeat": "comment-frame",
          "initialGap": "409-event_sequence_gap",
          "streamGap": "close-and-resynchronize",
          "resynchronizeOperationId": "resynchronizeTargetEvents",
          "authority": "notification-only",
          "durableActionDisconnect": "continues-until-terminal-or-explicit-cancel-command"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/TargetId"
          },
          {
            "$ref": "#/components/parameters/LastEventId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/TargetEventStream"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/targets/{targetId}/events/resync": {
      "get": {
        "operationId": "resynchronizeTargetEvents",
        "summary": "Resynchronize one target event cursor",
        "description": "Returns one authoritative target-state snapshot, its aggregate sequence, and an opaque resume token from the same resynchronization boundary. The caller discards its projected state, installs this snapshot, and reconnects watchTargetEvents with the returned token as Last-Event-ID.",
        "tags": [
          "reconciliation"
        ],
        "security": [
          {
            "targetReconcilerBearer": []
          }
        ],
        "x-bytedesk-port-operations": [
          "bytedesk.port.desired-state-store/1#read-target-state",
          "bytedesk.port.control-plane-api-events/1#resynchronize-events"
        ],
        "x-bytedesk-resynchronization": {
          "profile": "bytedesk.target-event-resynchronization/1",
          "triggers": [
            "event_sequence_gap",
            "unknown_schema",
            "resume_token_rejected"
          ],
          "result": "authoritative-target-state-plus-sequence-and-resume-token",
          "resume": "reconnect-watchTargetEvents-with-returned-token",
          "authority": "read-only"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/TargetId"
          },
          {
            "$ref": "#/components/parameters/KnownAggregateSequence"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/TargetEventResynchronization"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/targets/{targetId}/capability-evidence": {
      "post": {
        "operationId": "appendCapabilityEvidence",
        "summary": "Append nonce-bound consumer capability evidence",
        "description": "Accepts only current consumer capability-verifier evidence over the exact dispatch nonce. This append-only intake cannot write desired state, authorize promotion, grant a capability, or turn absence, timeout, transport failure, or malformed evidence into policy denial.",
        "tags": [
          "evidence",
          "promotion"
        ],
        "security": [
          {
            "capabilityVerifierMtls": []
          }
        ],
        "x-bytedesk-port-operation": "bytedesk.port.control-plane-api-events/1#append-capability-evidence",
        "x-bytedesk-authority": {
          "profile": "bytedesk.capability-evidence-intake/1",
          "effect": "append-only-evidence",
          "desiredStateWrite": false,
          "promotionAuthority": false,
          "capabilityGrantAuthority": false,
          "absenceOrTransportFailureIsDenial": false
        },
        "x-bytedesk-conditional-request": {
          "requiredHeader": "If-None-Match",
          "requiredValue": "*",
          "forbiddenHeader": "If-Match",
          "missingOrMismatch": "deny"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/TargetId"
          },
          {
            "$ref": "#/components/parameters/RequiredIfNoneMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CanonicalRequestDigest"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CapabilityEvidenceIntake"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/CapabilityEvidenceReceipt"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/targets/{targetId}/rollouts/{rolloutId}": {
