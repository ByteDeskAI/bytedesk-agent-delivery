{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/renderer-qualification-selection/1.0.0",
  "title": "Non-deployable renderer qualification selection",
  "type": "object",
  "required": [
    "contract",
    "schema",
    "purpose",
    "productRelease",
    "productDistribution",
    "compiledAllowlist",
    "capability",
    "rendererRelease",
    "targetHarness",
    "targetHarnessVersion",
    "rendererId",
    "rendererVersion",
    "targetPlatform",
    "executableDistribution",
    "contractBundle",
    "rendererSchemas",
    "workerProfileDigest",
    "normalizationProfile",
    "qualificationSuite",
    "conformancePlan",
    "inputCorpus",
    "evaluatorDistribution",
    "qualificationWorkerProfileDigest",
    "qualificationProtocolProfileDigest",
    "sandboxProfileDigest",
    "resourceProfileDigest",
    "timeoutProfileDigest",
    "productionEligible",
    "outputDisposition",
    "selectionDigest"
  ],
  "properties": {
    "contract": { "const": "bytedesk.renderer-qualification-selection/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "purpose": { "const": "release_qualification" },
    "productRelease": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "productDistribution": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "compiledAllowlist": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "capability": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "rendererRelease": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "targetHarness": { "type": "string", "enum": ["native", "hermes", "openclaw"] },
    "targetHarnessVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "rendererId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "rendererVersion": { "type": "string", "maxLength": 128, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "targetPlatform": { "type": "string", "enum": ["linux/amd64", "linux/arm64"] },
    "executableDistribution": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "contractBundle": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/contractBundleDescriptor" },
    "rendererSchemas": {
      "type": "object",
      "required": ["capability", "inputParameters", "harnessConfiguration", "compatibilityResult", "renderManifest"],
      "properties": {
        "capability": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
        "inputParameters": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
        "harnessConfiguration": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
        "compatibilityResult": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
        "renderManifest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "workerProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "normalizationProfile": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "qualificationSuite": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "conformancePlan": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "inputCorpus": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "evaluatorDistribution": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "qualificationWorkerProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "qualificationProtocolProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "sandboxProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "resourceProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "timeoutProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "productionEligible": { "const": false },
    "outputDisposition": { "const": "discard_after_evidence_capture" },
    "selectionDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "QS exists only to produce qualification evidence before G exists. Every qualification machinery field must equal the resolved suite exactly. Production rendering and deployment ports reject this contract even if its exact digest is trusted."
}
