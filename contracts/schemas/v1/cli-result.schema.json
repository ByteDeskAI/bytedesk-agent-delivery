{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/cli-result/1.0.0",
  "title": "Stable bd-agent machine result",
  "type": "object",
  "required": ["contract", "schema", "command", "invocationId", "correlationId", "outcome", "warnings", "emittedAt"],
  "properties": {
    "contract": { "const": "bytedesk.cli-result/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "command": { "type": "string", "pattern": "^[a-z][a-z0-9-]*( [a-z][a-z0-9-]*){0,3}$", "maxLength": 128 },
    "invocationId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "correlationId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "outcome": { "type": "string", "enum": ["succeeded", "accepted", "denied", "failed"] },
    "resource": {
      "type": "object",
      "required": ["uri", "schema", "digest", "etag"],
      "properties": {
        "uri": { "type": "string", "format": "uri-reference", "maxLength": 2048 },
        "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
        "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
        "etag": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "artifact": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "action": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "warnings": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" } },
    "problem": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/problem-details/1.0.0" },
    "emittedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "succeeded" } }, "required": ["outcome"] },
      "then": {
        "oneOf": [{ "required": ["resource"] }, { "required": ["artifact"] }],
        "not": { "anyOf": [{ "required": ["action"] }, { "required": ["problem"] }] }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "accepted" } }, "required": ["outcome"] },
      "then": {
        "required": ["action"],
        "not": { "anyOf": [{ "required": ["resource"] }, { "required": ["artifact"] }, { "required": ["problem"] }] }
      }
    },
    {
      "if": { "properties": { "outcome": { "enum": ["denied", "failed"] } }, "required": ["outcome"] },
      "then": {
        "required": ["problem"],
        "not": { "anyOf": [{ "required": ["resource"] }, { "required": ["artifact"] }, { "required": ["action"] }] }
      }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "With --output json this is the only stdout document. Logs and progress use stderr; credentials and secret values never appear."
}
