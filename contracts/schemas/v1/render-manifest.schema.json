{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/render-manifest/1.0.0",
  "title": "Deterministic public or private render manifest",
  "type": "object",
  "required": [
    "contract",
    "schema",
    "scope",
    "source",
    "sourceKind",
    "agentSpecVersion",
    "effectiveInputDigest",
    "publicSkills",
    "privateSkills",
    "effectiveSkillSetDigest",
    "skillApprovals",
    "harnessId",
    "rendererId",
    "rendererVersion",
    "productRelease",
    "rendererRelease",
    "executedDistribution",
    "platform",
    "productDistributionDigest",
    "compiledAllowlistDigest",
    "rendererSchemas",
    "inputParametersDigest",
    "harnessConfigurationDigest",
    "normalizationProfile",
    "outputArchiveProfile",
    "compatibility",
    "files",
    "output",
    "reproducibilityDigest"
  ],
  "properties": {
    "contract": { "const": "bytedesk.render-manifest/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "scope": { "type": "string", "enum": ["public", "private"] },
    "source": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "sourceKind": { "type": "string", "enum": ["agent", "specialized-agent"] },
    "agentSpecVersion": { "const": "26.1.2" },
    "effectiveInputDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
      "description": "SHA-256 of RFC 8785 JCS bytes for the closed bytedesk.renderer-effective-input/1 preimage defined by Renderer identity v1. Public inputs use explicit null binding/customization members."
    },
    "bindingDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "customizationDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "publicSkills": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" }
    },
    "privateSkills": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" }
    },
    "effectiveSkillSetDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
      "description": "SHA-256 of RFC 8785 JCS bytes for {profile:'bytedesk.renderer-effective-skill-set/1',publicSkills,privateSkills}, with exactly those members. Approval evidence is intentionally outside this functional identity."
    },
    "skillApprovals": {
      "type": "array",
      "maxItems": 20000,
      "uniqueItems": true,
      "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" }
    },
    "harnessId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "rendererId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "rendererVersion": { "type": "string", "maxLength": 128, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "productRelease": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "rendererRelease": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "executedDistribution": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "platform": { "type": "string", "enum": ["linux/amd64", "linux/arm64"] },
    "productDistributionDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "compiledAllowlistDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "rendererSchemas": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" }
    },
    "inputParametersDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "harnessConfigurationDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "normalizationProfile": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "outputArchiveProfile": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "compatibility": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/renderer-compatibility-result/1.0.0" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/outputFile" },
      "description": "Entries are strictly ordered by NFC UTF-8 path and have no exact, normalization, case-fold, ancestor, or reserved-path collision."
    },
    "output": {
      "type": "object",
      "required": ["digest", "treeDigest", "size", "expandedSize", "fileCount", "mediaType", "archiveProfile"],
      "properties": {
        "digest": {
          "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
          "description": "SHA-256 of the exact deterministic archive bytes; it is not derived from metadata or the logical tree digest."
        },
        "treeDigest": {
          "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
          "description": "SHA-256 of RFC 8785 JCS bytes for {profile:'bytedesk.renderer-output-tree/1',files}, with exactly those members."
        },
        "size": {
          "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonNegativeSafeInteger",
          "description": "Exact byte length of the deterministic archive identified by digest."
        },
        "expandedSize": {
          "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonNegativeSafeInteger",
          "description": "Must equal the safe-integer sum of every files[].size value."
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000,
          "description": "Must equal the exact length of files."
        },
        "mediaType": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/mediaType" },
        "archiveProfile": {
          "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier",
          "description": "Must equal the manifest outputArchiveProfile."
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "reproducibilityDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
      "description": "SHA-256 of RFC 8785 JCS bytes for {profile:'bytedesk.renderer-reproducibility/1',effectiveInputDigest,compatibilityDigest,output}, where compatibilityDigest is the JCS SHA-256 of the complete embedded compatibility object."
    }
  },
  "$defs": {
    "outputFile": {
      "type": "object",
      "required": ["path", "digest", "size", "mode", "origin", "ownershipClass"],
      "properties": {
        "path": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/portablePath" },
        "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
        "size": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonNegativeSafeInteger" },
        "mode": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/fileMode" },
        "origin": { "type": "string", "enum": ["generated", "source_payload", "public_skill", "private_skill"] },
        "ownershipClass": { "type": "string", "enum": ["runtime_read_only", "runtime_executable"] }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "public" } }, "required": ["scope"] },
      "then": {
        "properties": {
          "privateSkills": { "maxItems": 0 },
          "skillApprovals": { "maxItems": 0 }
        },
        "not": {
          "anyOf": [
            { "required": ["bindingDigest"] },
            { "required": ["customizationDigest"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "scope": { "const": "private" } }, "required": ["scope"] },
      "then": { "required": ["bindingDigest", "customizationDigest"] }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "The manifest is deterministic and contains no wall-clock field. Every object records a fresh full render; rendered public output is never patched or reused as the private effective render. Public manifests cannot represent consumer customization, private skills, approvals, secret references, or tenant identity. A private manifest records functional lineage and approval evidence digests without making them authorization or embedding credential values."
}
