{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/renderer-qualification-evidence-tree/1.0.0",
  "title": "Closed qualification collector evidence tree",
  "type": "object",
  "required": [
    "contract",
    "schema",
    "treeId",
    "qualificationSelectionDigest",
    "qualificationSuite",
    "attemptAuthorityDigest",
    "platform",
    "executedDistribution",
    "collectorIdentityDigest",
    "leaves",
    "treeDigest",
    "producedAt"
  ],
  "properties": {
    "contract": { "const": "bytedesk.renderer-qualification-evidence-tree/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "treeId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "qualificationSelectionDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "qualificationSuite": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "attemptAuthorityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "platform": { "type": "string", "enum": ["linux/amd64", "linux/arm64"] },
    "executedDistribution": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "collectorIdentityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "leaves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/leaf" }
    },
    "treeDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "producedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
  },
  "$defs": {
    "role": {
      "type": "string",
      "enum": ["provenance", "sbom", "vulnerability", "malware", "secret_scan", "scan_completeness", "license", "conformance", "compatibility", "determinism", "sandbox", "executed_distribution"]
    },
    "subjectRole": {
      "type": "string",
      "enum": ["product_distribution", "product_release", "renderer_release", "renderer_executable", "contract_bundle"]
    },
    "leaf": {
      "type": "object",
      "required": ["index", "requirementId", "role", "subjectRole", "subject", "details", "result", "statementDigest", "producerSigningResult", "leafDigest"],
      "properties": {
        "index": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonNegativeSafeInteger" },
        "requirementId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
        "role": { "$ref": "#/$defs/role" },
        "subjectRole": { "$ref": "#/$defs/subjectRole" },
        "subject": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
        "details": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
        "result": { "const": "pass" },
        "statementDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
        "producerSigningResult": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/signing-result/1.0.0" },
        "leafDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "Produced by the trusted qualification launcher/collector, never by renderer code. Every typed evidence leaf is signed independently and consumed exactly once by the qualification finalizer."
}
