{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/release-qualification-evidence/1.0.0",
  "title": "Typed exact-subject release qualification evidence binding",
  "type": "object",
  "required": ["contract", "schema", "evidenceId", "role", "subjectRole", "subject", "predicateContract", "predicateSchema", "predicate", "qualificationSelection", "qualificationAttempt", "qualificationAttemptAuthenticationEvidence", "qualificationReceipt", "qualificationReceiptAuthenticationEvidence", "evidenceTree", "evidenceLeafIndex", "evidenceLeafDigest", "evidenceLeafStatementDigest", "evidenceLeafSigningResult", "result", "observedAt", "expiresAt", "trustPolicy"],
  "properties": {
    "contract": { "const": "bytedesk.release-qualification-evidence/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "evidenceId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "role": { "type": "string", "enum": ["provenance", "sbom", "vulnerability", "malware", "secret_scan", "scan_completeness", "license", "conformance", "compatibility", "determinism", "sandbox", "executed_distribution"] },
    "subjectRole": { "type": "string", "enum": ["product_distribution", "product_release", "renderer_release", "renderer_executable", "contract_bundle"] },
    "subject": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "predicateContract": { "const": "bytedesk.release-qualification-predicate/1" },
    "predicateSchema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "predicate": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "qualificationSelection": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "qualificationAttempt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "qualificationAttemptAuthenticationEvidence": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "qualificationReceipt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "qualificationReceiptAuthenticationEvidence": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "evidenceTree": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "evidenceLeafIndex": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonNegativeSafeInteger" },
    "evidenceLeafDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "evidenceLeafStatementDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "evidenceLeafSigningResult": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/signing-result/1.0.0" },
    "result": { "const": "pass" },
    "observedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "trustPolicy": { "type": "object", "required": ["id", "digest"], "properties": { "id": { "const": "release-qualification-evidence-v1" }, "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" } }, "additionalProperties": false, "unevaluatedProperties": false }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "The sealed graph verifier resolves predicate bytes and requires the role-specific contract/schema/media/purpose plus an exact subject descriptor equal to subject. A generic descriptor is never sufficient."
}
