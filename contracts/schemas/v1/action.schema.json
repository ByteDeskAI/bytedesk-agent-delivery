{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/action/1.0.0",
  "title": "Durable asynchronous action",
  "type": "object",
  "required": ["contract", "schema", "actionId", "scope", "correlationId", "causationId", "kind", "inputDigest", "state", "progress", "attempt", "cancellable", "precondition", "predecessor", "createdAt", "updatedAt"],
  "properties": {
    "contract": { "const": "bytedesk.action/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "actionId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "public" } },
          "additionalProperties": false,
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "consumerId"],
          "properties": {
            "kind": { "const": "consumer" },
            "consumerId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" }
          },
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      ]
    },
    "correlationId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "causationId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "kind": { "type": "string", "enum": ["validate", "render", "package", "publish", "import", "compile", "sign", "promote", "recover", "withdraw", "retire", "reconcile", "archive", "restore", "region_failover"] },
    "inputDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "state": { "type": "string", "enum": ["queued", "claimed", "running", "retry_wait", "cancellation_requested", "succeeded", "failed", "cancelled", "dead_lettered"] },
    "progress": {
      "type": "object",
      "required": ["phase", "completed", "total", "unit", "updatedAt"],
      "properties": {
        "phase": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
        "completed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "total": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          ]
        },
        "unit": { "type": "string", "enum": ["items", "bytes", "checks", "steps", "percent", "unknown"] },
        "checkpointDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
        "updatedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "cancellable": { "type": "boolean" },
    "precondition": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/precondition/1.0.0" },
    "predecessor": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/predecessor/1.0.0" },
    "createdAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "updatedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "artifact"],
          "properties": {
            "kind": { "const": "artifact" },
            "artifact": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" }
          },
          "additionalProperties": false,
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "uri", "schema", "digest", "etag"],
          "properties": {
            "kind": { "const": "resource" },
            "uri": { "type": "string", "format": "uri-reference", "maxLength": 2048 },
            "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
            "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
            "etag": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
          },
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      ]
    },
    "resultContract": {
      "type": "string",
      "enum": ["bytedesk.action-result.validate/1", "bytedesk.action-result.render/1", "bytedesk.action-result.package/1", "bytedesk.action-result.publish/1", "bytedesk.action-result.import/1", "bytedesk.action-result.compile/1", "bytedesk.action-result.sign/1", "bytedesk.action-result.promote/1", "bytedesk.action-result.recover/1", "bytedesk.action-result.withdraw/1", "bytedesk.action-result.retire/1", "bytedesk.action-result.reconcile/1", "bytedesk.action-result.archive/1", "bytedesk.action-result.restore/1", "bytedesk.action-result.region-failover/1"]
    },
    "problem": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/problem-details/1.0.0" },
    "cancellationEvidence": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/redactedEvidenceRef" },
    "deadLetterEvidence": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/redactedEvidenceRef" },
    "fenceEvidence": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/redactedEvidenceRef" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "succeeded" } }, "required": ["state"] },
      "then": {
        "required": ["result", "resultContract"],
        "properties": {
          "progress": {
            "properties": { "phase": { "const": "complete" }, "total": { "not": { "type": "null" } } },
            "required": ["phase", "total"]
          }
        },
        "not": {
          "anyOf": [
            { "required": ["problem"] },
            { "required": ["cancellationEvidence"] },
            { "required": ["deadLetterEvidence"] },
            { "required": ["fenceEvidence"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
      "then": {
        "required": ["problem"],
        "not": {
          "anyOf": [
            { "required": ["result"] },
            { "required": ["cancellationEvidence"] },
            { "required": ["deadLetterEvidence"] },
            { "required": ["fenceEvidence"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "cancelled" } }, "required": ["state"] },
      "then": {
        "required": ["cancellationEvidence"],
        "properties": { "cancellable": { "const": true } },
        "not": {
          "anyOf": [
            { "required": ["result"] },
            { "required": ["problem"] },
            { "required": ["deadLetterEvidence"] },
            { "required": ["fenceEvidence"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "dead_lettered" } }, "required": ["state"] },
      "then": {
        "required": ["deadLetterEvidence"],
        "anyOf": [
          { "required": ["problem"] },
          { "required": ["fenceEvidence"] }
        ],
        "not": {
          "anyOf": [
            { "required": ["result"] },
            { "required": ["cancellationEvidence"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "cancellation_requested" } }, "required": ["state"] },
      "then": { "properties": { "cancellable": { "const": true } } }
    },
    {
      "if": {
        "properties": {
          "state": { "enum": ["queued", "claimed", "running", "cancellation_requested"] }
        },
        "required": ["state"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["result"] },
            { "required": ["cancellationEvidence"] },
            { "required": ["deadLetterEvidence"] },
            { "required": ["fenceEvidence"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "retry_wait" } }, "required": ["state"] },
      "then": {
        "anyOf": [
          { "required": ["problem"] },
          { "required": ["fenceEvidence"] }
        ],
        "not": {
          "anyOf": [
            { "required": ["result"] },
            { "required": ["cancellationEvidence"] },
            { "required": ["deadLetterEvidence"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "state": { "not": { "const": "succeeded" } } }, "required": ["state"] },
      "then": { "not": { "required": ["resultContract"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "validate" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.validate/1" },
          "result": { "properties": { "kind": { "const": "resource" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "render" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.render/1" },
          "result": { "properties": { "kind": { "const": "artifact" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "package" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.package/1" },
          "result": { "properties": { "kind": { "const": "artifact" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "publish" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.publish/1" },
          "result": { "properties": { "kind": { "const": "resource" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "import" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.import/1" },
          "result": { "properties": { "kind": { "const": "resource" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "compile" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.compile/1" },
          "result": { "properties": { "kind": { "const": "artifact" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "sign" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.sign/1" },
          "result": { "properties": { "kind": { "const": "artifact" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "promote" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.promote/1" },
          "result": { "properties": { "kind": { "const": "resource" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "recover" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.recover/1" },
          "result": { "properties": { "kind": { "const": "resource" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "withdraw" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.withdraw/1" },
          "result": { "properties": { "kind": { "const": "resource" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "retire" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.retire/1" },
          "result": { "properties": { "kind": { "const": "resource" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "reconcile" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.reconcile/1" },
          "result": { "properties": { "kind": { "const": "resource" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "archive" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.archive/1" },
          "result": { "properties": { "kind": { "const": "resource" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "restore" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.restore/1" },
          "result": { "properties": { "kind": { "const": "artifact" } }, "required": ["kind"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "region_failover" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "resultContract": { "const": "bytedesk.action-result.region-failover/1" },
          "result": { "properties": { "kind": { "const": "resource" } }, "required": ["kind"] }
        }
      }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
