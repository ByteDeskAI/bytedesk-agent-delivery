{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/renderer-qualification-receipt/1.0.0",
  "title": "Qualification-only actual execution receipt",
  "type": "object",
  "required": [
    "contract",
    "schema",
    "attemptId",
    "attemptFencingToken",
    "attemptAuthorityDigest",
    "attemptAuthenticationEvidenceDigest",
    "qualificationSelectionDigest",
    "rendererReleaseDigest",
    "platform",
    "executedDistribution",
    "inputTreeDigest",
    "contractBundleDigest",
    "qualificationSuiteDigest",
    "conformancePlanDigest",
    "inputCorpusDigest",
    "evaluatorDistribution",
    "qualificationWorkerProfileDigest",
    "qualificationProtocolProfileDigest",
    "framedRequestDigest",
    "framedResponseDigest",
    "evidenceTree",
    "evidenceTreeDigest",
    "sandboxProfileDigest",
    "resourceProfileDigest",
    "timeoutProfileDigest",
    "rendererWorkerProfileDigest",
    "launcherIdentityDigest",
    "completedAt"
  ],
  "properties": {
    "contract": { "const": "bytedesk.renderer-qualification-receipt/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "attemptId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "attemptFencingToken": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
    "attemptAuthorityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "attemptAuthenticationEvidenceDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "qualificationSelectionDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "rendererReleaseDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "platform": { "type": "string", "enum": ["linux/amd64", "linux/arm64"] },
    "executedDistribution": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "inputTreeDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "contractBundleDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "qualificationSuiteDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "conformancePlanDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "inputCorpusDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "evaluatorDistribution": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "qualificationWorkerProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "qualificationProtocolProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "framedRequestDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "framedResponseDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "evidenceTree": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor", "description": "Exact published closed evidence tree collected from the isolated qualification output; its descriptor digest must equal evidenceTreeDigest." },
    "evidenceTreeDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "sandboxProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "resourceProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "timeoutProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "rendererWorkerProfileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "launcherIdentityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "completedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "The receipt records actual evaluator, corpus, plan, contract, protocol, resource, timeout, target renderer, and sandbox readback. The evidence tree is never a production render and is discarded after typed evidence capture."
}
