{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/problem-details/1.0.0",
  "title": "Closed Agent Delivery RFC 9457 problem details",
  "type": "object",
  "required": ["type", "title", "status", "code", "correlationId"],
  "properties": {
    "type": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://problems\\.bytedesk\\.ai/agent-delivery/" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "type": "integer", "minimum": 400, "maximum": 599 },
    "detail": { "type": "string", "maxLength": 2048 },
    "instance": { "type": "string", "format": "uri-reference", "maxLength": 2048 },
    "code": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_]{0,127}$" },
    "correlationId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "retryAfterSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
