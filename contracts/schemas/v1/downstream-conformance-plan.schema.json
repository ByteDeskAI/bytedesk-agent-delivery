{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/downstream-conformance-plan/1.0.0",
  "title": "Compiled downstream conformance execution plan",
  "description": "An exact, adapter-consumable compilation of downstream conformance requirements. Referenced port contract fixtures are schema-valid structural samples and are never semantic implementation evidence.",
  "type": "object",
  "required": [
    "$schema",
    "profile",
    "version",
    "semantics",
    "inputs",
    "goldenInvocations",
    "cases"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.bytedesk.ai/agent-delivery/v1/downstream-conformance-plan/1.0.0"
    },
    "profile": {
      "const": "bytedesk.downstream-conformance-plan/1"
    },
    "version": {
      "const": 1
    },
    "semantics": {
      "$ref": "#/$defs/semantics"
    },
    "inputs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/inputBinding"
      }
    },
    "goldenInvocations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/goldenInvocation"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/compiledCase"
      }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sha256": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "portId": {
      "type": "string",
      "pattern": "^bytedesk\\.port\\.[a-z0-9-]+/1$",
      "maxLength": 128
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 128
    },
    "protocolProfileIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^bytedesk\\.[a-z0-9-]+/1$",
        "maxLength": 128
      }
    },
    "contractId": {
      "type": "string",
      "pattern": "^bytedesk\\.port\\.[a-z0-9-]+\\.[a-z0-9-]+\\.(?:request|result)/1$",
      "maxLength": 512
    },
    "semantics": {
      "type": "object",
      "required": [
        "contractFixtureValidity",
        "semanticImplementationGolden",
        "adapterExecutionRequired"
      ],
      "properties": {
        "contractFixtureValidity": {
          "const": "schema-valid-only"
        },
        "semanticImplementationGolden": {
          "const": false
        },
        "adapterExecutionRequired": {
          "const": true
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "inputBinding": {
      "type": "object",
      "required": [
        "role",
        "path",
        "profile",
        "digest"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "port-registry",
            "type-catalog",
            "contract-fixtures",
            "problem-catalog",
            "action-catalog",
            "event-types",
            "protocol-profiles",
            "case-catalog",
            "protocol-fixtures"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^contracts/(?:ports|events)/v1/[a-z0-9-]+\\.json$",
          "maxLength": 256
        },
        "profile": {
          "$ref": "#/$defs/nonemptyString"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "fixtureReference": {
      "type": "object",
      "required": [
        "catalogPath",
        "contractId",
        "selector",
        "validity",
        "instanceDigest"
      ],
      "properties": {
        "catalogPath": {
          "const": "contracts/ports/v1/contract-fixtures.json"
        },
        "contractId": {
          "$ref": "#/$defs/contractId"
        },
        "selector": {
          "const": "valid"
        },
        "validity": {
          "const": "schema-valid-structural-sample"
        },
        "instanceDigest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "contractReference": {
      "type": "object",
      "required": [
        "contractId",
        "schemaId",
        "schemaDigest",
        "fixture"
      ],
      "properties": {
        "contractId": {
          "$ref": "#/$defs/contractId"
        },
        "schemaId": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://schemas\\.bytedesk\\.ai/agent-delivery/v1/ports/contracts/",
          "maxLength": 1024
        },
        "schemaDigest": {
          "$ref": "#/$defs/sha256"
        },
        "fixture": {
          "$ref": "#/$defs/fixtureReference"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "passOracle": {
      "type": "object",
      "required": [
        "outcome",
        "problemCode",
        "sideEffectState"
      ],
      "properties": {
        "outcome": {
          "const": "pass"
        },
        "problemCode": {
          "type": "null"
        },
        "sideEffectState": {
          "const": "none"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "denyOracle": {
      "type": "object",
      "required": [
        "outcome",
        "problemCode",
        "sideEffectState"
      ],
      "properties": {
        "outcome": {
          "const": "deny"
        },
        "problemCode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 128
        },
        "sideEffectState": {
          "type": "string",
          "enum": [
            "none",
            "not-committed",
            "committed-unchanged",
            "commit-unknown"
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "recoverOracle": {
      "type": "object",
      "required": [
        "outcome",
        "problemCode",
        "sideEffectState"
      ],
      "properties": {
        "outcome": {
          "const": "recover"
        },
        "problemCode": {
          "type": "null"
        },
        "sideEffectState": {
          "type": "string",
          "enum": [
            "none",
            "commit-unknown"
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "oracle": {
      "oneOf": [
        {
          "$ref": "#/$defs/passOracle"
        },
        {
          "$ref": "#/$defs/denyOracle"
        },
        {
          "$ref": "#/$defs/recoverOracle"
        }
      ]
    },
    "goldenHarness": {
      "type": "object",
      "required": [
        "action",
        "faultPhase",
        "directiveId"
      ],
      "properties": {
        "action": {
          "const": "invoke"
        },
        "faultPhase": {
          "const": "none"
        },
        "directiveId": {
          "type": "string",
          "pattern": "^bytedesk\\.conformance\\.operation/",
          "maxLength": 512
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "goldenInvocation": {
      "type": "object",
      "required": [
        "invocationId",
        "portId",
        "operationId",
        "protocolProfileIds",
        "semanticImplementationGolden",
        "request",
        "result",
        "harness",
        "oracle"
      ],
      "properties": {
        "invocationId": {
          "type": "string",
          "pattern": "^bytedesk\\.port\\.[a-z0-9-]+/1#[a-z][a-z0-9-]*:schema-golden/1$",
          "maxLength": 512
        },
        "portId": {
          "$ref": "#/$defs/portId"
        },
        "operationId": {
          "$ref": "#/$defs/operationId"
        },
        "protocolProfileIds": {
          "$ref": "#/$defs/protocolProfileIds"
        },
        "semanticImplementationGolden": {
          "const": false
        },
        "request": {
          "$ref": "#/$defs/contractReference"
        },
        "result": {
          "$ref": "#/$defs/contractReference"
        },
        "harness": {
          "$ref": "#/$defs/goldenHarness"
        },
        "oracle": {
          "$ref": "#/$defs/passOracle"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "directive": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "assertion",
            "fault",
            "fixture-scenario",
            "harness-profile",
            "mutation",
            "recovery",
            "protocol-fixture",
            "protocol-mutation"
          ]
        },
        "value": {
          "$ref": "#/$defs/nonemptyString"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "caseHarness": {
      "type": "object",
      "required": [
        "action",
        "faultPhase",
        "directiveId",
        "sourceFixtureDigest",
        "directives",
        "protocolFixtureIds",
        "protocolMutationIds"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "invoke",
            "assert-requirement",
            "apply-case-mutation",
            "execute-protocol-mutations",
            "inject-fault",
            "resolve"
          ]
        },
        "faultPhase": {
          "type": "string",
          "enum": [
            "none",
            "request-validation",
            "authentication",
            "authorization",
            "precondition",
            "dependency",
            "execution",
            "commit",
            "after-commit-before-response",
            "verification",
            "recovery"
          ]
        },
        "directiveId": {
          "type": "string",
          "pattern": "^bytedesk\\.conformance\\.case/",
          "maxLength": 512
        },
        "sourceFixtureDigest": {
          "$ref": "#/$defs/sha256"
        },
        "directives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/directive"
          }
        },
        "protocolFixtureIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "protocolMutationIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "execute-protocol-mutations"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "protocolFixtureIds": {
                "minItems": 1
              },
              "protocolMutationIds": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "protocolFixtureIds": {
                "maxItems": 0
              },
              "protocolMutationIds": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "caseStep": {
      "type": "object",
      "required": [
        "stepId",
        "role",
        "portId",
        "operationId",
        "protocolProfileIds",
        "request",
        "result",
        "harness",
        "oracle"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[0-9]{3}$",
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "enum": [
            "setup",
            "subject",
            "recovery"
          ]
        },
        "portId": {
          "$ref": "#/$defs/portId"
        },
        "operationId": {
          "$ref": "#/$defs/operationId"
        },
        "protocolProfileIds": {
          "$ref": "#/$defs/protocolProfileIds"
        },
        "request": {
          "$ref": "#/$defs/contractReference"
        },
        "result": {
          "$ref": "#/$defs/contractReference"
        },
        "harness": {
          "$ref": "#/$defs/caseHarness"
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        }
      },
      "oneOf": [
        {
          "properties": {
            "role": {
              "const": "setup"
            },
            "harness": {
              "properties": {
                "action": {
                  "const": "invoke"
                },
                "faultPhase": {
                  "const": "none"
                }
              }
            },
            "oracle": {
              "$ref": "#/$defs/passOracle"
            }
          }
        },
        {
          "properties": {
            "role": {
              "const": "subject"
            },
            "harness": {
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "assert-requirement",
                    "apply-case-mutation",
                    "execute-protocol-mutations",
                    "inject-fault"
                  ]
                },
                "faultPhase": {
                  "not": {
                    "enum": [
                      "none",
                      "recovery"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "role": {
              "const": "recovery"
            },
            "harness": {
              "properties": {
                "action": {
                  "const": "resolve"
                },
                "faultPhase": {
                  "const": "recovery"
                }
              }
            },
            "oracle": {
              "$ref": "#/$defs/passOracle"
            }
          }
        }
      ],
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "executionSemantics": {
      "type": "object",
      "required": [
        "adapterExecutionRequired",
        "semanticImplementationGolden",
        "sourceCasePath"
      ],
      "properties": {
        "adapterExecutionRequired": {
          "const": true
        },
        "semanticImplementationGolden": {
          "const": false
        },
        "sourceCasePath": {
          "const": "contracts/ports/v1/conformance-cases.json"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "compiledCase": {
      "type": "object",
      "required": [
        "caseId",
        "sourceCaseDigest",
        "suite",
        "ownerTask",
        "category",
        "execution",
        "steps",
        "oracle"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[A-Za-z0-9-]+$",
          "maxLength": 256
        },
        "sourceCaseDigest": {
          "$ref": "#/$defs/sha256"
        },
        "suite": {
          "$ref": "#/$defs/nonemptyString"
        },
        "ownerTask": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^AD-[0-9]{2}$"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 128
        },
        "execution": {
          "$ref": "#/$defs/executionSemantics"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/caseStep"
          }
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
