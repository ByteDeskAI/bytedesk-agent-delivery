{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/trust-policy-pin-set-provider-evidence/1.0.0",
  "title": "Trust-policy pin-set activation and readback evidence",
  "x-bytedesk-digestAuthority": {
    "profile": "bytedesk.trust-policy-pin-set-provider-evidence-digest/1",
    "fields": [
      "evidenceId",
      "requestId",
      "idempotencyKey",
      "requestDigest",
      "pinSet",
      "pinSetId",
      "scope",
      "consumerId",
      "revision",
      "pinSetDigest",
      "precondition",
      "providerId",
      "providerAuthorityDigest",
      "providerRequestId",
      "providerAuditId",
      "result",
      "activatedAt",
      "readback"
    ]
  },
  "type": "object",
  "required": [
    "contract",
    "schema",
    "evidenceId",
    "requestId",
    "idempotencyKey",
    "requestDigest",
    "pinSet",
    "pinSetId",
    "scope",
    "consumerId",
    "revision",
    "pinSetDigest",
    "precondition",
    "providerId",
    "providerAuthorityDigest",
    "providerRequestId",
    "providerAuditId",
    "result",
    "activatedAt",
    "readback",
    "evidenceDigest"
  ],
  "properties": {
    "contract": { "const": "bytedesk.trust-policy-pin-set-provider-evidence/1" },
    "schema": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor"
    },
    "evidenceId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "requestId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "idempotencyKey": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "requestDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "pinSet": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/trust-policy-pin-set-descriptor/1.0.0" },
    "pinSetId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "scope": { "type": "string", "enum": ["product", "consumer"] },
    "consumerId": {
      "oneOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "revision": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
    "pinSetDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "precondition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "absent" } },
          "additionalProperties": false,
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "revision", "digest"],
          "properties": {
            "kind": { "const": "match" },
            "revision": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
            "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
          },
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      ]
    },
    "providerId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "providerAuthorityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "providerRequestId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "providerAuditId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "result": { "const": "active" },
    "activatedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "readback": {
      "type": "object",
      "required": ["pinSet", "rawDigest", "observedAt"],
      "properties": {
        "pinSet": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/trust-policy-pin-set-descriptor/1.0.0" },
        "rawDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
        "observedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "evidenceDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "product" } }, "required": ["scope"] },
      "then": { "properties": { "consumerId": { "type": "null" } } },
      "else": { "properties": { "consumerId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" } } }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "Append-only provider evidence that the exact non-self-signed pin-set bytes were atomically activated and independently read back under a configured provider trust anchor."
}
