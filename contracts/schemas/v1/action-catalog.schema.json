{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/action-catalog/1.0.0",
  "title": "Stable asynchronous action kind catalog",
  "type": "object",
  "required": [
    "$schema",
    "profile",
    "version",
    "actions"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.bytedesk.ai/agent-delivery/v1/action-catalog/1.0.0"
    },
    "profile": {
      "const": "bytedesk.action-catalog/1"
    },
    "version": {
      "const": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/actionKind"
      }
    }
  },
  "$defs": {
    "actionKind": {
      "type": "object",
      "required": [
        "kind",
        "portId",
        "operationId",
        "requestContract",
        "resultContractClass",
        "terminalResultContract",
        "ownerTask",
        "cancellableUntil",
        "idempotency",
        "failureCodes"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "validate",
            "render",
            "package",
            "publish",
            "import",
            "compile",
            "sign",
            "promote",
            "recover",
            "withdraw",
            "retire",
            "reconcile",
            "archive",
            "restore",
            "region_failover"
          ]
        },
        "portId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^bytedesk\\.port\\.[a-z0-9-]+/1$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "requestContract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^bytedesk\\.port\\.[a-z0-9-]+\\.[a-z0-9-]+\\.request/1$"
        },
        "resultContractClass": {
          "type": "string",
          "enum": [
            "artifact",
            "resource"
          ]
        },
        "terminalResultContract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^bytedesk\\.action-result\\.[a-z0-9-]+/1$"
        },
        "ownerTask": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^AD-(?:0[2-9]|1[0-8])$"
        },
        "cancellableUntil": {
          "type": "string",
          "enum": [
            "before-active-slot-switch",
            "before-archive-root-cas",
            "before-catalog-commit",
            "before-first-registry-write",
            "before-managed-resource-commit",
            "before-private-artifact-publication",
            "before-recovery-rollout-start",
            "before-region-epoch-commit",
            "before-restored-evidence-publication",
            "before-retirement-commit",
            "before-signature-issued",
            "before-target-state-cas",
            "before-withdrawal-commit",
            "before-worker-dispatch"
          ]
        },
        "idempotency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "failureCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/problemCode"
          }
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "problemCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
