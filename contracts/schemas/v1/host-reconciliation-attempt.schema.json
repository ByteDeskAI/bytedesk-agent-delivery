{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/host-reconciliation-attempt/1.0.0",
  "title": "Target-bound Host Reconciler technical attempt",
  "type": "object",
  "required": ["contract", "schema", "attemptId", "consumerId", "subjectId", "targetId", "rolloutId", "desiredRevision", "release", "deployment", "slotId", "generation", "activationMode", "hostIdentity", "fencingToken", "regionEpoch", "leaseExpiresAt", "journalHead", "switchDisposition", "state", "startedAt", "updatedAt"],
  "properties": {
    "contract": { "const": "bytedesk.host-reconciliation-attempt/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "attemptId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "consumerId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "subjectId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "targetId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "rolloutId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "desiredRevision": {
      "type": "object",
      "required": ["revision", "digest"],
      "properties": {
        "revision": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
        "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "release": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/consumerRuntimeReleaseDescriptor" },
    "deployment": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/consumerDeploymentDescriptor" },
    "slotId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "generation": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
    "activationMode": { "type": "string", "enum": ["isolated_candidate", "guarded_in_place"] },
    "hostIdentity": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "fencingToken": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
    "regionEpoch": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
    "leaseExpiresAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "journalHead": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
      ]
    },
    "switchDisposition": { "type": "string", "enum": ["pre_intent", "intent_recorded", "switch_committed", "readback_confirmed", "indeterminate"] },
    "state": { "type": "string", "enum": ["claimed", "staging", "staged", "preflighting", "preflight_passed", "switching", "indeterminate", "verifying", "observing", "retry_wait", "succeeded", "cancelled", "fenced", "failed"] },
    "technicalEvidence": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "problem": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/problem-details/1.0.0" },
    "startedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "updatedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "succeeded" } }, "required": ["state"] },
      "then": { "required": ["technicalEvidence"], "not": { "required": ["problem"] } }
    },
    {
      "if": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
      "then": { "required": ["technicalEvidence", "problem"] }
    },
    {
      "if": { "properties": { "state": { "enum": ["cancelled", "fenced"] } }, "required": ["state"] },
      "then": { "required": ["technicalEvidence"], "not": { "required": ["problem"] } }
    },
    {
      "if": { "properties": { "state": { "const": "retry_wait" } }, "required": ["state"] },
      "then": { "required": ["problem"] }
    },
    {
      "if": { "properties": { "state": { "const": "indeterminate" } }, "required": ["state"] },
      "then": {
        "required": ["problem"],
        "properties": { "switchDisposition": { "const": "indeterminate" } }
      }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "Contains technical host evidence only and cannot carry capability, credential, promotion, or desired-state authority. Fence loss before switch intent aborts; fence loss at or after intent requires digest-chain journal recovery. An indeterminate physical switch stops service until exact readback proves the predecessor or candidate generation."
}
