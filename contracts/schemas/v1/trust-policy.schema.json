{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/trust-policy/1.0.0",
  "title": "Immutable independently distributed trust policy",
  "type": "object",
  "required": ["contract", "schema", "policyId", "version", "effective", "scope", "signers", "requiredEvidence", "rules", "revocations", "failureMode", "predecessor"],
  "properties": {
    "contract": { "const": "bytedesk.trust-policy/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "policyId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "version": { "type": "string", "maxLength": 128, "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "effective": {
      "type": "object",
      "required": ["notBefore", "notAfter"],
      "properties": {
        "notBefore": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
        "notAfter": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["repositories", "mediaTypes", "purposes"],
      "properties": {
        "repositories": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/ociRepository" } },
        "mediaTypes": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255 } },
        "purposes": { "type": "array", "minItems": 1, "maxItems": 22, "uniqueItems": true, "items": { "type": "string", "enum": ["product-release-v1", "contract-bundle-release-v1", "public-source-v1", "public-render-v1", "consumer-private-skill-v1", "consumer-authority-v1", "consumer-deployment-v1", "consumer-runtime-release-v1", "release-qualification-policy-v1", "release-qualification-attempt-v1", "release-qualification-receipt-v1", "release-qualification-evidence-v1", "release-qualification-decision-v1", "release-status-v1", "release-status-head-v1", "release-status-eligibility-v1", "consumer-release-status-eligibility-v1", "renderer-attempt-v1", "renderer-execution-v1", "consumer-compilation-input-v1", "consumer-compilation-evidence-v1", "consumer-activation-authorization-v1"] } },
        "consumers": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" } },
        "targets": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" } }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "signers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/signer-identity/1.0.0" }
    },
    "requiredEvidence": { "type": "array", "minItems": 1, "maxItems": 19, "uniqueItems": true, "items": { "type": "string", "enum": ["schema", "provenance", "sbom", "vulnerability", "license", "compatibility", "evaluation", "authority", "skill_approval", "canary", "readiness", "conformance", "determinism", "malware", "secret_scan", "executed_distribution", "scan_completeness", "freshness", "consistency"] } },
    "rules": {
      "type": "object",
      "required": ["freshnessSeconds", "requireNonce", "requirePredecessor", "denyDowngrade", "withdrawal", "outage"],
      "properties": {
        "freshnessSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "requireNonce": { "type": "boolean" },
        "requirePredecessor": { "type": "boolean" },
        "denyDowngrade": { "type": "boolean" },
        "withdrawal": { "type": "string", "enum": ["deny_new_use", "deny_all"] },
        "outage": { "type": "string", "enum": ["fail_closed_new_work", "deny_all"] }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "revocations": {
      "type": "object",
      "required": ["keyVersions", "digests", "workflows", "builders", "schemas", "renderers", "content"],
      "properties": {
        "keyVersions": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "type": "string", "maxLength": 2048 } },
        "digests": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" } },
        "workflows": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "type": "string", "maxLength": 1024 } },
        "builders": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" } },
        "schemas": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" } },
        "renderers": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" } },
        "content": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" } }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "failureMode": { "const": "fail_closed" },
    "predecessor": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/predecessor/1.0.0" }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "scope": {
                "properties": {
                  "purposes": { "contains": { "const": "contract-bundle-release-v1" } }
                },
                "required": ["purposes"]
              }
            },
            "required": ["scope"]
          },
          {
            "properties": {
              "scope": {
                "properties": {
                  "mediaTypes": {
                    "contains": {
                      "enum": [
                        "application/vnd.bytedesk.agent.contract-bundle.v1+json",
                        "application/vnd.bytedesk.agent.contract-bundle.v1+tar"
                      ]
                    }
                  }
                },
                "required": ["mediaTypes"]
              }
            },
            "required": ["scope"]
          },
          {
            "properties": {
              "signers": {
                "contains": {
                  "properties": {
                    "purpose": { "const": "contract-bundle-release-v1" }
                  },
                  "required": ["purpose"]
                }
              }
            },
            "required": ["signers"]
          }
        ]
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "repositories": { "maxItems": 1 },
              "mediaTypes": {
                "const": [
                  "application/vnd.bytedesk.agent.contract-bundle.v1+json"
                ]
              },
              "purposes": { "const": ["contract-bundle-release-v1"] }
            },
            "required": ["repositories", "mediaTypes", "purposes"]
          },
          "signers": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "properties": {
                "purpose": { "const": "contract-bundle-release-v1" },
                "credentialKind": { "const": "sigstore_keyless" }
              },
              "required": ["purpose", "credentialKind"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "purposes": { "contains": { "enum": ["product-release-v1", "contract-bundle-release-v1"] } }
            },
            "required": ["purposes"]
          }
        },
        "required": ["scope"]
      },
      "then": {
        "properties": {
          "requiredEvidence": {
            "allOf": [
              { "contains": { "const": "schema" } },
              { "contains": { "const": "provenance" } },
              { "contains": { "const": "sbom" } },
              { "contains": { "const": "vulnerability" } },
              { "contains": { "const": "license" } },
              { "contains": { "const": "compatibility" } },
              { "contains": { "const": "conformance" } },
              { "contains": { "const": "determinism" } },
              { "contains": { "const": "malware" } },
              { "contains": { "const": "secret_scan" } },
              { "contains": { "const": "executed_distribution" } },
              { "contains": { "const": "scan_completeness" } }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "purposes": { "contains": { "enum": ["public-source-v1", "consumer-private-skill-v1"] } }
            },
            "required": ["purposes"]
          }
        },
        "required": ["scope"]
      },
      "then": {
        "properties": {
          "requiredEvidence": {
            "allOf": [
              { "contains": { "const": "schema" } },
              { "contains": { "const": "provenance" } },
              { "contains": { "const": "sbom" } },
              { "contains": { "const": "vulnerability" } },
              { "contains": { "const": "license" } },
              { "contains": { "const": "malware" } },
              { "contains": { "const": "secret_scan" } },
              { "contains": { "const": "scan_completeness" } }
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
