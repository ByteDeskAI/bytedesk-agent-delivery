{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/signer-authentication-evidence/1.0.0",
  "title": "Resolved provider signer authentication evidence",
  "type": "object",
  "required": [
    "contract",
    "schema",
    "purpose",
    "requestId",
    "requestDigest",
    "providerRequestId",
    "providerAuditId",
    "keyVersion",
    "algorithm",
    "publicKeyDigest",
    "authenticatedSigner",
    "trustPolicy",
    "issuedAt"
  ],
  "properties": {
    "contract": { "const": "bytedesk.signer-authentication-evidence/1" },
    "schema": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "product-release-v1",
        "public-source-v1",
        "public-render-v1",
        "consumer-private-skill-v1",
        "consumer-authority-v1",
        "consumer-deployment-v1",
        "consumer-runtime-release-v1",
        "release-qualification-policy-v1",
        "release-qualification-attempt-v1",
        "release-qualification-receipt-v1",
        "release-qualification-evidence-v1",
        "release-qualification-decision-v1",
        "release-status-v1",
        "release-status-head-v1",
        "release-status-eligibility-v1",
        "consumer-release-status-eligibility-v1",
        "renderer-attempt-v1",
        "renderer-execution-v1",
        "consumer-compilation-input-v1",
        "consumer-compilation-evidence-v1",
        "consumer-activation-authorization-v1"
      ]
    },
    "requestId": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier"
    },
    "requestDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "providerRequestId": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier"
    },
    "providerAuditId": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier"
    },
    "keyVersion": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "algorithm": { "const": "ECDSA_P256_SHA256" },
    "publicKeyDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "authenticatedSigner": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/signer-identity/1.0.0"
    },
    "trustPolicy": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/trustPolicyRef"
    },
    "issuedAt": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "Exact offline provider evidence for the authenticated signer and signing request. The signature bundle binds this artifact descriptor; verifiers resolve it and compare it to the independently resolved trust policy."
}
