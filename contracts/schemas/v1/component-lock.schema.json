{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/component-lock/1.0.0",
  "title": "Signed reference component and configuration lock",
  "type": "object",
  "required": ["contract", "schema", "profileId", "profileVersion", "components", "configurationDigest", "generatedAt", "trustPolicy"],
  "properties": {
    "contract": { "const": "bytedesk.component-lock/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "profileId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "profileVersion": { "type": "string", "maxLength": 128, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["name", "kind", "version", "platforms", "source", "configurationDigest"],
        "properties": {
          "name": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
          "kind": { "type": "string", "enum": ["image", "chart", "binary", "wheel", "action", "crd", "node_image"] },
          "version": { "type": "string", "minLength": 1, "maxLength": 128 },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "items": {
              "type": "object",
              "required": ["platform", "digest"],
              "properties": {
                "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
                "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
              },
              "additionalProperties": false,
              "unevaluatedProperties": false
            }
          },
          "source": { "type": "string", "format": "uri", "maxLength": 2048 },
          "configurationDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
        },
        "additionalProperties": false,
        "unevaluatedProperties": false
      }
    },
    "configurationDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "generatedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "trustPolicy": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/trustPolicyRef" }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
