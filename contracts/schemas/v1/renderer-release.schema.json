{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/renderer-release/1.0.0",
  "title": "Complete immutable renderer release identity",
  "x-bytedesk-digestAuthority": { "profile": "bytedesk.renderer-release-authority-digest/1", "exclude": ["contract", "schema", "authorityDigest", "signingResult"] },
  "type": "object",
  "required": ["contract", "schema", "harnessId", "rendererId", "version", "rendererContractVersion", "source", "supportedAgentSpecVersions", "supportedHarnessVersions", "schemas", "capabilityManifest", "workerProtocol", "platforms", "builder", "toolchainDigest", "dependencyLockDigest", "normalizationProfile", "publishedAt", "trustPolicy", "authorityDigest", "signingResult"],
  "properties": {
    "contract": { "const": "bytedesk.renderer-release/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "harnessId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "rendererId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "version": { "type": "string", "maxLength": 128, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "rendererContractVersion": { "type": "string", "maxLength": 128, "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "treeDigest"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "maxLength": 2048 },
        "commit": { "type": "string", "maxLength": 64, "pattern": "^[0-9a-f]{40,64}$" },
        "treeDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "supportedAgentSpecVersions": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "type": "string", "maxLength": 128, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } },
    "supportedHarnessVersions": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "schemas": {
      "type": "object",
      "required": ["capability", "inputParameters", "harnessConfiguration", "compatibilityResult", "renderManifest"],
      "properties": {
        "capability": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
        "inputParameters": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
        "harnessConfiguration": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
        "compatibilityResult": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
        "renderManifest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "capabilityManifest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor",
      "description": "Exact signed pre-release renderer-capability object. Its harness, renderer, version, contract version, source, schemas, and supported platforms must equal this release; the capability cannot contain a release backlink."
    },
    "workerProtocol": {
      "type": "object",
      "required": ["profileId", "profileDigest", "framing", "payloadEncoding", "oneRequestPerProcess"],
      "properties": {
        "profileId": { "const": "bytedesk.worker-framing/1" },
        "profileDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
        "framing": { "const": "uint32-be-length-prefixed" },
        "payloadEncoding": { "const": "rfc8785-jcs-json" },
        "oneRequestPerProcess": { "const": true }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "description": "Platform entries must also be unique by the semantic os/architecture selection key; the renderer conformance validator enforces that property-level invariant.",
      "items": {
        "type": "object",
        "required": ["os", "architecture", "distribution"],
        "properties": {
          "os": { "type": "string", "enum": ["linux"] },
          "architecture": { "type": "string", "enum": ["amd64", "arm64"] },
          "distribution": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" }
        },
        "additionalProperties": false,
        "unevaluatedProperties": false
      }
    },
    "builder": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "toolchainDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "dependencyLockDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "normalizationProfile": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "publishedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "trustPolicy": {
      "allOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/trustPolicyRef" },
        { "properties": { "id": { "const": "product-release-v1" } }, "required": ["id"] }
      ]
    },
    "authorityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "signingResult": {
      "allOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/signing-result/1.0.0" },
        { "properties": { "purpose": { "const": "product-release-v1" }, "subjectMediaType": { "const": "application/vnd.bytedesk.agent.renderer-release.v1+json" } }, "required": ["purpose", "subjectMediaType"] }
      ]
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
