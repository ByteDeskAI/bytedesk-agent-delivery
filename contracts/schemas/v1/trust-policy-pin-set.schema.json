{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/trust-policy-pin-set/1.0.0",
  "title": "Externally authenticated trust-policy pin set",
  "x-bytedesk-digestAuthority": {
    "profile": "bytedesk.trust-policy-pin-set-digest/1",
    "fields": [
      "pinSetId",
      "scope",
      "consumerId",
      "revision",
      "precondition",
      "currentForNewUse",
      "historicalVerification",
      "revocations",
      "effective"
    ]
  },
  "type": "object",
  "required": [
    "contract",
    "schema",
    "pinSetId",
    "scope",
    "consumerId",
    "revision",
    "precondition",
    "currentForNewUse",
    "historicalVerification",
    "revocations",
    "effective",
    "pinSetDigest"
  ],
  "properties": {
    "contract": { "const": "bytedesk.trust-policy-pin-set/1" },
    "schema": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor"
    },
    "pinSetId": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier"
    },
    "scope": { "type": "string", "enum": ["product", "consumer"] },
    "consumerId": {
      "oneOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "revision": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger"
    },
    "precondition": { "$ref": "#/$defs/precondition" },
    "currentForNewUse": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/pin" },
      "description": "Complete replacement map with exactly one current policy per required purpose. Purpose completeness, uniqueness, and canonical byte ordering are semantic requirements."
    },
    "historicalVerification": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/historicalPin" },
      "description": "Bounded independently enumerated retired policies retained only to verify signatures created while that policy was pinned. These policies cannot authorize new selection, publication, compilation, or activation."
    },
    "revocations": {
      "type": "object",
      "required": ["policyDigests", "keyVersions", "publicKeyDigests"],
      "properties": {
        "policyDigests": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
        },
        "keyVersions": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" }
        },
        "publicKeyDigests": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "effective": {
      "type": "object",
      "required": ["notBefore", "notAfter"],
      "properties": {
        "notBefore": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
        "notAfter": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "pinSetDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    }
  },
  "$defs": {
    "trustPolicyReference": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
        "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "pin": {
      "type": "object",
      "required": ["purpose", "trustPolicy"],
      "properties": {
        "purpose": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
        "trustPolicy": { "$ref": "#/$defs/trustPolicyReference" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "historicalPin": {
      "type": "object",
      "required": ["purpose", "trustPolicy", "validForSigning"],
      "properties": {
        "purpose": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
        "trustPolicy": { "$ref": "#/$defs/trustPolicyReference" },
        "validForSigning": {
          "type": "object",
          "required": ["notBefore", "notAfter"],
          "properties": {
            "notBefore": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
            "notAfter": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
          },
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "precondition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "absent" } },
          "additionalProperties": false,
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "revision", "digest"],
          "properties": {
            "kind": { "const": "match" },
            "revision": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
            "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
          },
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "product" } }, "required": ["scope"] },
      "then": { "properties": { "consumerId": { "type": "null" } } },
      "else": { "properties": { "consumerId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" } } }
    },
    {
      "if": { "properties": { "revision": { "const": 1 } }, "required": ["revision"] },
      "then": { "properties": { "precondition": { "properties": { "kind": { "const": "absent" } }, "required": ["kind"] } } },
      "else": { "properties": { "precondition": { "properties": { "kind": { "const": "match" } }, "required": ["kind"] } } }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "A complete externally authenticated pin-set revision. The set is activated and read back through the trusted provider port; it is deliberately not self-signed by any policy that it contains."
}
