{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/release-status-log-consistency-proof/1.0.0",
  "title": "Signed release-status log consistency proof",
  "x-bytedesk-digestAuthority": {
    "profile": "bytedesk.release-status-log-consistency-proof-authority-digest/1",
    "exclude": ["contract", "schema", "authorityDigest", "signingResult"]
  },
  "type": "object",
  "required": [
    "contract",
    "schema",
    "proofId",
    "subjectKind",
    "subject",
    "from",
    "to",
    "algorithm",
    "auditPath",
    "proofDataDigest",
    "authorityBindingDigest",
    "trustPolicy",
    "authorityDigest",
    "signingResult"
  ],
  "properties": {
    "contract": { "const": "bytedesk.release-status-log-consistency-proof/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "proofId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "subjectKind": { "type": "string", "enum": ["product_release", "renderer_release"] },
    "subject": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "from": { "$ref": "#/$defs/logEndpoint" },
    "to": { "$ref": "#/$defs/logEndpoint" },
    "algorithm": { "const": "bytedesk-rfc6962-prefix-consistency-v1" },
    "auditPath": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
      },
      "description": "Bounded logarithmic RFC 6962-style prefix consistency audit path."
    },
    "proofDataDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
      "description": "Digest of the closed proof-data profile, subject kind and descriptor, endpoints, and complete logarithmic audit path."
    },
    "authorityBindingDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
      "description": "Exact digest of the same complete permitted signer, trust-policy reference, and signing repository bound by the checkpoint authentication evidence."
    },
    "trustPolicy": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "const": "release-status-head-v1" },
        "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "authorityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "signingResult": {
      "allOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/signing-result/1.0.0" },
        {
          "properties": {
            "purpose": { "const": "release-status-head-v1" },
            "subjectMediaType": { "const": "application/vnd.bytedesk.agent.release-status-log-consistency-proof.v1+json" }
          },
          "required": ["purpose", "subjectMediaType"]
        }
      ]
    }
  },
  "$defs": {
    "logEndpoint": {
      "type": "object",
      "required": ["treeSize", "sequence", "epoch", "headDigest", "logRootDigest"],
      "properties": {
        "treeSize": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
        "sequence": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
        "epoch": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
        "headDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
        "logRootDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "A purpose-separated status-log authority signs a bounded logarithmic RFC 6962-style prefix consistency proof for one release subject. Verifiers prove the persisted root is an exact prefix of the fresh root, separately verify the current head inclusion proof, and authenticate the complete signer/policy binding."
}
