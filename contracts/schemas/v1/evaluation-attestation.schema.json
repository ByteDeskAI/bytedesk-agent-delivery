{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/evaluation-attestation/1.0.0",
  "title": "Closed artifact evaluation attestation",
  "type": "object",
  "required": ["contract", "schema", "subject", "policy", "result", "checks", "evaluatedAt", "evaluator", "trustPolicy"],
  "properties": {
    "contract": { "const": "bytedesk.evaluation-attestation/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "subject": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "policy": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/trustPolicyRef" },
    "result": { "type": "string", "enum": ["passed", "failed", "manual_review"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["id", "result", "evidenceDigest"],
        "properties": {
          "id": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
          "result": { "type": "string", "enum": ["passed", "failed", "not_applicable"] },
          "evidenceDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
        },
        "additionalProperties": false,
        "unevaluatedProperties": false
      }
    },
    "evaluatedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "evaluator": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "trustPolicy": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/trustPolicyRef" }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
