{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/signing-request/1.0.0",
  "title": "Purpose-separated exact-digest signing request",
  "type": "object",
  "required": ["contract", "schema", "requestId", "purpose", "keyVersion", "repository", "digest", "mediaType", "trustPolicy", "nonce", "issuedAt", "expiresAt"],
  "properties": {
    "contract": { "const": "bytedesk.signing-request/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "requestId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "purpose": {
      "type": "string",
      "enum": ["product-release-v1", "public-source-v1", "public-render-v1", "consumer-private-skill-v1", "consumer-authority-v1", "consumer-deployment-v1"]
    },
    "keyVersion": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "repository": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/ociRepository" },
    "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "mediaType": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/mediaType" },
    "trustPolicy": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/trustPolicyRef" },
    "consumerId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "nonce": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonce" },
    "issuedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "purpose": { "enum": ["consumer-private-skill-v1", "consumer-authority-v1", "consumer-deployment-v1"] } }, "required": ["purpose"] },
      "then": { "required": ["consumerId"] },
      "else": { "not": { "required": ["consumerId"] } }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
