{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/signing-request/1.0.0",
  "title": "Purpose-separated exact-digest signing request",
  "type": "object",
  "required": ["contract", "schema", "requestId", "purpose", "credentialKind", "signerIdentityDigest", "repository", "digest", "mediaType", "trustPolicy", "nonce", "issuedAt", "expiresAt"],
  "properties": {
    "contract": { "const": "bytedesk.signing-request/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "requestId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "purpose": {
      "type": "string",
      "enum": ["product-release-v1", "contract-bundle-release-v1", "public-source-v1", "public-render-v1", "consumer-private-skill-v1", "consumer-authority-v1", "consumer-deployment-v1", "consumer-runtime-release-v1", "release-qualification-policy-v1", "release-qualification-attempt-v1", "release-qualification-receipt-v1", "release-qualification-evidence-v1", "release-qualification-decision-v1", "release-status-v1", "release-status-head-v1", "release-status-eligibility-v1", "consumer-release-status-eligibility-v1", "renderer-attempt-v1", "renderer-execution-v1", "consumer-compilation-input-v1", "consumer-compilation-evidence-v1", "consumer-activation-authorization-v1"]
    },
    "credentialKind": {
      "type": "string",
      "enum": ["kms_key", "sigstore_keyless"]
    },
    "keyVersion": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "signerIdentityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "builderDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "preSignCertificationDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "repository": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/ociRepository" },
    "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "mediaType": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/mediaType" },
    "trustPolicy": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/trustPolicyRef" },
    "consumerId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "nonce": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonce" },
    "issuedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "credentialKind": { "const": "kms_key" } }, "required": ["credentialKind"] },
      "then": { "required": ["keyVersion"] }
    },
    {
      "if": { "properties": { "credentialKind": { "const": "sigstore_keyless" } }, "required": ["credentialKind"] },
      "then": {
        "properties": {
          "purpose": { "const": "contract-bundle-release-v1" },
          "mediaType": { "const": "application/vnd.bytedesk.agent.contract-bundle.v1+json" }
        },
        "not": { "required": ["keyVersion"] }
      }
    },
    {
      "if": { "properties": { "purpose": { "enum": ["product-release-v1", "contract-bundle-release-v1"] } }, "required": ["purpose"] },
      "then": { "required": ["builderDigest", "preSignCertificationDigest"] }
    },
    {
      "if": {
        "properties": {
          "mediaType": {
            "enum": [
              "application/vnd.bytedesk.agent.contract-bundle.v1+json",
              "application/vnd.bytedesk.agent.contract-bundle.v1+tar"
            ]
          }
        },
        "required": ["mediaType"]
      },
      "then": { "properties": { "purpose": { "const": "contract-bundle-release-v1" }, "credentialKind": { "const": "sigstore_keyless" } } }
    },
    {
      "if": { "properties": { "purpose": { "const": "contract-bundle-release-v1" } }, "required": ["purpose"] },
      "then": { "properties": { "mediaType": { "const": "application/vnd.bytedesk.agent.contract-bundle.v1+json" }, "credentialKind": { "const": "sigstore_keyless" } } }
    },
    {
      "if": { "properties": { "purpose": { "enum": ["consumer-private-skill-v1", "consumer-authority-v1", "consumer-deployment-v1", "consumer-runtime-release-v1", "consumer-compilation-input-v1", "consumer-compilation-evidence-v1", "consumer-release-status-eligibility-v1", "consumer-activation-authorization-v1"] } }, "required": ["purpose"] },
      "then": { "required": ["consumerId"] },
      "else": { "not": { "required": ["consumerId"] } }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
