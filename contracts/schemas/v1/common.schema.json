{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0",
  "title": "ByteDesk Agent Delivery v1 common definitions",
  "$defs": {
    "sha256": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,255})$"
    },
    "contractName": {
      "type": "string",
      "pattern": "^bytedesk\\.[a-z0-9.-]+/[1-9][0-9]*$",
      "maxLength": 128
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+(?:;[ -~]+)?$"
    },
    "schemaDescriptor": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://schemas\\.bytedesk\\.ai/agent-delivery/"
        },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "trustPolicyRef": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "ociRepository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "oneOf": [
        {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$"
        },
        {
          "pattern": "^\\[(?:(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}|(?:[0-9a-f]{1,4}:){1,7}:|(?:[0-9a-f]{1,4}:){1,6}:[0-9a-f]{1,4}|(?:[0-9a-f]{1,4}:){1,5}(?::[0-9a-f]{1,4}){1,2}|(?:[0-9a-f]{1,4}:){1,4}(?::[0-9a-f]{1,4}){1,3}|(?:[0-9a-f]{1,4}:){1,3}(?::[0-9a-f]{1,4}){1,4}|(?:[0-9a-f]{1,4}:){1,2}(?::[0-9a-f]{1,4}){1,5}|[0-9a-f]{1,4}:(?:(?::[0-9a-f]{1,4}){1,6})|:(?:(?::[0-9a-f]{1,4}){1,7}|:))\\](?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$"
        }
      ],
      "description": "Lowercase tag-, digest-, query-, fragment-, whitespace-, and scheme-free OCI repository. A colon is accepted only for a validated registry port or inside a bracketed IPv6 registry."
    },
    "artifactDescriptor": {
      "type": "object",
      "required": ["repository", "digest", "mediaType", "size", "trustPolicy"],
      "properties": {
        "repository": { "$ref": "#/$defs/ociRepository" },
        "digest": { "$ref": "#/$defs/sha256" },
        "mediaType": { "$ref": "#/$defs/mediaType" },
        "size": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "trustPolicy": { "$ref": "#/$defs/trustPolicyRef" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mediaType": {
                "const": "application/vnd.bytedesk.agent.contract-bundle.v1+json"
              }
            },
            "required": ["mediaType"]
          },
          "then": {
            "properties": {
              "trustPolicy": {
                "properties": { "id": { "const": "contract-bundle-release-v1" } },
                "required": ["id"]
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "mediaType": { "const": "application/vnd.bytedesk.agent.contract-bundle.v1+tar" }
            },
            "required": ["mediaType"]
          }
        },
        {
          "if": {
            "properties": {
              "trustPolicy": {
                "properties": { "id": { "const": "contract-bundle-release-v1" } },
                "required": ["id"]
              }
            },
            "required": ["trustPolicy"]
          },
          "then": {
            "properties": {
              "mediaType": { "const": "application/vnd.bytedesk.agent.contract-bundle.v1+json" }
            }
          }
        }
      ],
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "evidenceBlobDescriptor": {
      "type": "object",
      "required": ["repository", "digest", "mediaType", "size"],
      "properties": {
        "repository": { "$ref": "#/$defs/ociRepository" },
        "digest": { "$ref": "#/$defs/sha256" },
        "mediaType": { "$ref": "#/$defs/mediaType" },
        "size": { "$ref": "#/$defs/nonNegativeSafeInteger" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "description": "Exact non-authoritative blob identity used only inside independently verified evidence. It has no trust-policy reference and acquires no authority from its enclosing artifact; the trusted Adapter must resolve and authenticate its exact bytes."
    },
    "contractBundleDescriptor": {
      "allOf": [
        { "$ref": "#/$defs/artifactDescriptor" },
        {
          "properties": {
            "mediaType": { "const": "application/vnd.bytedesk.agent.contract-bundle.v1+json" },
            "trustPolicy": {
              "properties": { "id": { "const": "contract-bundle-release-v1" } },
              "required": ["id"]
            }
          },
          "required": ["mediaType", "trustPolicy"]
        }
      ],
      "description": "Exact descriptor role for the JSON contract bundle signed under the contract-bundle-release-v1 keyless purpose."
    },
    "consumerDeploymentDescriptor": {
      "allOf": [
        { "$ref": "#/$defs/artifactDescriptor" },
        {
          "properties": {
            "mediaType": { "const": "application/vnd.bytedesk.agent.consumer-deployment.v1+json" },
            "trustPolicy": {
              "properties": { "id": { "const": "consumer-deployment-v1" } },
              "required": ["id"]
            }
          }
        }
      ],
      "description": "Exact descriptor role for a consumer deployment signed under the consumer-deployment-v1 purpose."
    },
    "consumerRuntimeReleaseDescriptor": {
      "allOf": [
        { "$ref": "#/$defs/artifactDescriptor" },
        {
          "properties": {
            "mediaType": { "const": "application/vnd.bytedesk.agent.runtime-release.v1+json" },
            "trustPolicy": {
              "properties": { "id": { "const": "consumer-runtime-release-v1" } },
              "required": ["id"]
            }
          }
        }
      ],
      "description": "Exact descriptor role for a runtime release signed under the consumer-runtime-release-v1 purpose."
    },
    "contentDescriptor": {
      "$ref": "#/$defs/artifactDescriptor"
    },
    "precondition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "absent" } },
          "additionalProperties": false,
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "revision", "digest"],
          "properties": {
            "kind": { "const": "match" },
            "revision": { "$ref": "#/$defs/positiveSafeInteger" },
            "digest": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      ]
    },
    "predecessor": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } },
          "additionalProperties": false,
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "revision", "digest"],
          "properties": {
            "kind": { "const": "match" },
            "revision": { "$ref": "#/$defs/positiveSafeInteger" },
            "digest": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      ]
    },
    "schemaHeader": {
      "type": "object",
      "required": ["contract", "schema"],
      "properties": {
        "contract": { "$ref": "#/$defs/contractName" },
        "schema": { "$ref": "#/$defs/schemaDescriptor" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/\\x00-\\x1F\\x5C\\x7F]+(?:/[^/\\x00-\\x1F\\x5C\\x7F]+){0,31}$",
      "allOf": [
        { "not": { "pattern": "(^|/)\\.{1,2}(/|$)" } },
        { "not": { "pattern": ":" } },
        { "not": { "pattern": "[<>\"|?*]" } },
        { "not": { "pattern": "(^|/)[^/]*[. ](/|$)" } },
        { "not": { "pattern": "(^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm](?:[1-9]|[¹²³])|[Ll][Pp][Tt](?:[1-9]|[¹²³]))(?:\\.[^/]*)?(/|$)" } }
      ],
      "description": "NFC portable POSIX relative regular-file path. JSON Schema maxLength counts Unicode characters; semantic validation additionally limits the complete path to 1024 UTF-8 bytes and every path segment to 255 UTF-8 bytes, and rejects normalization and case-fold collisions. Windows device names, forbidden filename characters, alternate data streams, drive syntax, and segments ending in dot or space are invalid on every target platform."
    },
    "fileMode": {
      "type": "string",
      "enum": ["0444", "0555", "0644", "0755"]
    },
    "fileInventoryEntry": {
      "type": "object",
      "required": ["path", "digest", "size", "mode"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "digest": { "$ref": "#/$defs/sha256" },
        "size": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "mode": { "$ref": "#/$defs/fileMode" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "platform": {
      "type": "string",
      "enum": ["linux/amd64", "linux/arm64"]
    },
    "resultClass": {
      "type": "string",
      "enum": ["permitted", "policy_denied", "not_applicable", "passed", "failed"]
    },
    "redactedEvidenceRef": {
      "type": "object",
      "required": ["digest", "classification"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha256" },
        "classification": {
          "type": "string",
          "enum": ["public", "consumer-private", "restricted"]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  }
}
