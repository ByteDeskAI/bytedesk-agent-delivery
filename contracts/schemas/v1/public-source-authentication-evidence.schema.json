{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/public-source-authentication-evidence/1.0.0",
  "title": "Detached public source or skill authentication evidence",
  "x-bytedesk-digestAuthority": {
    "profile": "bytedesk.public-source-authentication-evidence-digest/1",
    "fields": ["purpose", "subject", "publisherIdentityDigest", "signingResult"]
  },
  "type": "object",
  "required": [
    "contract",
    "schema",
    "purpose",
    "subject",
    "publisherIdentityDigest",
    "signingResult",
    "evidenceDigest"
  ],
  "properties": {
    "contract": { "const": "bytedesk.public-source-authentication-evidence/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "purpose": { "const": "public-source-v1" },
    "subject": {
      "allOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
        {
          "properties": {
            "mediaType": { "enum": ["application/vnd.bytedesk.agent.source.v1+json", "application/vnd.bytedesk.agent.skill.v1+json"] },
            "trustPolicy": { "properties": { "id": { "const": "public-source-v1" } }, "required": ["id"] }
          },
          "required": ["mediaType", "trustPolicy"]
        }
      ]
    },
    "publisherIdentityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "signingResult": {
      "allOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/signing-result/1.0.0" },
        {
          "properties": {
            "purpose": { "const": "public-source-v1" },
            "subjectMediaType": { "enum": ["application/vnd.bytedesk.agent.source.v1+json", "application/vnd.bytedesk.agent.skill.v1+json"] }
          },
          "required": ["purpose", "subjectMediaType"]
        }
      ]
    },
    "evidenceDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "The tenant-free public render binds one evidence object for its exact public source and every exact public skill. The complete signing result authenticates the subject digest and media type under the isolated public-source publisher policy."
}
