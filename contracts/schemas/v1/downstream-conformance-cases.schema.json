        "outcome": {
          "type": "string",
          "enum": [
            "deny",
            "pass",
            "recover"
          ]
        },
        "problemCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          ]
        },
        "sideEffectState": {
          "type": "string",
          "enum": [
            "commit-unknown",
            "committed-unchanged",
            "none",
            "not-committed"
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
