      "required": [
        "caseId",
        "suite",
        "portSuites",
        "ownerTask",
        "covers",
        "category",
        "fixture",
        "expected"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}-[a-z0-9-]+$"
        },
        "suite": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^downstream\\.[a-z0-9.-]+$"
        },
        "portSuites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^downstream\\.[a-z0-9.-]+$"
          }
        },
        "ownerTask": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^AD-(?:0[2-9]|1[0-8])$"
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/coverage"
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "actor-separation",
            "authentication-denial",
            "authority-boundary",
