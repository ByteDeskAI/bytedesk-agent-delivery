{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/release-qualification-predicate/1.0.0",
  "title": "Closed typed qualification predicate",
  "type": "object",
  "required": [
    "contract",
    "schema",
    "predicateId",
    "requirementId",
    "role",
    "subjectRole",
    "subject",
    "qualificationSuite",
    "qualificationSelectionDigest",
    "qualificationReceiptDigest",
    "conformancePlanDigest",
    "inputCorpusDigest",
    "evaluatorDistribution",
    "evidenceTree",
    "evidenceLeafIndex",
    "evidenceLeafDigest",
    "evidenceLeafStatementDigest",
    "evidenceLeafSigningResult",
    "details",
    "result",
    "producedAt",
    "trustPolicy"
  ],
  "properties": {
    "contract": { "const": "bytedesk.release-qualification-predicate/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "predicateId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "requirementId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "role": { "type": "string", "enum": ["provenance", "sbom", "vulnerability", "malware", "secret_scan", "scan_completeness", "license", "conformance", "compatibility", "determinism", "sandbox", "executed_distribution"] },
    "subjectRole": { "type": "string", "enum": ["product_distribution", "product_release", "renderer_release", "renderer_executable", "contract_bundle"] },
    "subject": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "qualificationSuite": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "qualificationSelectionDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "qualificationReceiptDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "conformancePlanDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "inputCorpusDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "evaluatorDistribution": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "evidenceTree": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "evidenceLeafIndex": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonNegativeSafeInteger" },
    "evidenceLeafDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "evidenceLeafStatementDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "evidenceLeafSigningResult": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/signing-result/1.0.0" },
    "details": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "result": { "const": "pass" },
    "producedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "trustPolicy": { "$ref": "#/$defs/qualificationTrust" }
  },
  "$defs": {
    "qualificationTrust": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "const": "release-qualification-evidence-v1" },
        "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "A pass is independently auditable only when its exact subject, suite, evaluator, plan, corpus, receipt, and details artifact resolve and agree with the requirement matrix."
}
