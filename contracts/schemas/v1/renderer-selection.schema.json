{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/renderer-selection/1.0.0",
  "title": "Closed renderer selection authority",
  "x-bytedesk-digestAuthority": {
    "profile": "bytedesk.renderer-selection-digest/1",
    "fields": [
      "targetHarness",
      "targetHarnessVersion",
      "rendererId",
      "rendererVersion",
      "productRelease",
      "releaseQualification",
      "productReleaseStatus",
      "productReleaseStatusCheckpoint",
      "productReleaseStatusCheckpointAuthenticationEvidence",
      "productReleaseStatusRequestNonce",
      "rendererReleaseStatus",
      "rendererReleaseStatusCheckpoint",
      "rendererReleaseStatusCheckpointAuthenticationEvidence",
      "rendererReleaseStatusRequestNonce",
      "productDistribution",
      "compiledAllowlist",
      "capability",
      "rendererRelease",
      "targetPlatform",
      "executableDistribution",
      "productDistributionDigest",
      "compiledAllowlistDigest",
      "rendererSchemas",
      "workerProfileDigest",
      "normalizationProfile",
      "operationTime"
    ]
  },
  "type": "object",
  "required": [
    "contract",
    "schema",
    "targetHarness",
    "targetHarnessVersion",
    "rendererId",
    "rendererVersion",
    "productRelease",
    "releaseQualification",
    "productReleaseStatus",
    "productReleaseStatusCheckpoint",
    "productReleaseStatusCheckpointAuthenticationEvidence",
    "productReleaseStatusRequestNonce",
    "rendererReleaseStatus",
    "rendererReleaseStatusCheckpoint",
    "rendererReleaseStatusCheckpointAuthenticationEvidence",
    "rendererReleaseStatusRequestNonce",
    "productDistribution",
    "compiledAllowlist",
    "capability",
    "rendererRelease",
    "targetPlatform",
    "executableDistribution",
    "productDistributionDigest",
    "compiledAllowlistDigest",
    "rendererSchemas",
    "workerProfileDigest",
    "normalizationProfile",
    "operationTime",
    "selectionDigest"
  ],
  "properties": {
    "contract": {
      "const": "bytedesk.renderer-selection/1"
    },
    "schema": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor"
    },
    "targetHarness": {
      "type": "string",
      "enum": [
        "native",
        "hermes",
        "openclaw"
      ]
    },
    "targetHarnessVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rendererId": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier"
    },
    "rendererVersion": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "productRelease": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor",
      "description": "Exact signed immutable product-release-manifest M that binds P, A, the complete R set, and contract bundle. Qualification evidence is bound later by releaseQualification G."
    },
    "releaseQualification": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor",
      "description": "Exact signed release-qualification G whose M and complete R set match this selection."
    },
    "productReleaseStatus": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor"
    },
    "productReleaseStatusCheckpoint": {
      "$ref": "#/$defs/statusHeadCheckpointDescriptor"
    },
    "productReleaseStatusCheckpointAuthenticationEvidence": {
      "$ref": "#/$defs/statusHeadAuthenticationEvidenceDescriptor"
    },
    "productReleaseStatusRequestNonce": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonce"
    },
    "rendererReleaseStatus": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor"
    },
    "rendererReleaseStatusCheckpoint": {
      "$ref": "#/$defs/statusHeadCheckpointDescriptor"
    },
    "rendererReleaseStatusCheckpointAuthenticationEvidence": {
      "$ref": "#/$defs/statusHeadAuthenticationEvidenceDescriptor"
    },
    "rendererReleaseStatusRequestNonce": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonce"
    },
    "productDistribution": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor",
      "description": "Exact closed product-distribution-manifest P; its embedded allowlist must equal compiledAllowlist."
    },
    "compiledAllowlist": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor"
    },
    "capability": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor"
    },
    "rendererRelease": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor",
      "description": "Exact descriptor whose digest identifies the complete signed renderer-release manifest."
    },
    "targetPlatform": {
      "type": "string",
      "enum": [
        "linux/amd64",
        "linux/arm64"
      ]
    },
    "executableDistribution": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor",
      "description": "The one platform distribution selected from the signed renderer release."
    },
    "productDistributionDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "compiledAllowlistDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "rendererSchemas": {
      "type": "object",
      "required": [
        "capability",
        "inputParameters",
        "harnessConfiguration",
        "compatibilityResult",
        "renderManifest"
      ],
      "properties": {
        "capability": {
          "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor"
        },
        "inputParameters": {
          "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor"
        },
        "harnessConfiguration": {
          "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor"
        },
        "compatibilityResult": {
          "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor"
        },
        "renderManifest": {
          "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "workerProfileDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "normalizationProfile": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier"
    },
    "operationTime": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp",
      "description": "Caller-supplied trusted selection time used for status freshness, trust-policy validity, and revocation evaluation. It is part of the exact selection authority preimage."
    },
    "selectionDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
      "description": "SHA-256 of RFC 8785 JCS bytes for the exact bytedesk.renderer-selection-digest/1 preimage defined by Renderer identity v1."
    }
  },
  "$defs": {
    "statusHeadCheckpointDescriptor": {
      "allOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
        { "properties": { "mediaType": { "const": "application/vnd.bytedesk.agent.release-status-head-checkpoint.v1+json" } }, "required": ["mediaType"] }
      ]
    },
    "statusHeadAuthenticationEvidenceDescriptor": {
      "allOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
        { "properties": { "mediaType": { "const": "application/vnd.bytedesk.agent.release-status-head-authentication-evidence.v1+json" } }, "required": ["mediaType"] }
      ]
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "One immutable Strategy decision carried unchanged through Adapter selection, sandbox execution, output validation, and render lineage. Runtime or host state cannot re-resolve any member."
}
