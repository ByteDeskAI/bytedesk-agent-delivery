{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/event-types/1.0.0",
  "title": "Stable Agent Delivery CloudEvents type registry",
  "type": "object",
  "required": [
    "$schema",
    "profile",
    "cloudEventsVersion",
    "delivery",
    "ordering",
    "authority",
    "eventTypes",
    "registryCompatibility",
    "resynchronization"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.bytedesk.ai/agent-delivery/v1/event-types/1.0.0"
    },
    "profile": {
      "const": "bytedesk.event-types/1"
    },
    "cloudEventsVersion": {
      "const": "1.0.2"
    },
    "delivery": {
      "const": "at-least-once"
    },
    "ordering": {
      "const": "per-aggregate-sequence"
    },
    "authority": {
      "const": "notification-only"
    },
    "eventTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/eventType"
      }
    },
    "registryCompatibility": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "resynchronization": {
      "$ref": "#/$defs/resynchronization"
    }
  },
  "$defs": {
    "eventType": {
      "type": "object",
      "required": [
        "type",
        "aggregateType",
        "resourceSchemaId",
        "resourceSchemaDigest",
        "resourceUriTemplate",
        "resynchronizeOperationId",
        "redaction"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^ai\\.bytedesk\\.agent-delivery\\.[a-z0-9.-]+\\.v1$"
        },
        "aggregateType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "resourceSchemaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^https://schemas\\.bytedesk\\.ai/agent-delivery/v1/[a-z0-9-]+/1\\.0\\.0$"
        },
        "resourceSchemaDigest": {
          "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
        },
        "resourceUriTemplate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^/v1/"
        },
        "resynchronizeOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "redaction": {
          "type": "string",
          "enum": [
            "consumer-private",
            "public"
          ]
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "resynchronization": {
      "type": "object",
      "required": [
        "authority",
        "on",
        "resumeAfter"
      ],
      "properties": {
        "authority": {
          "const": "authenticated-api-read"
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "unknown-event-type",
              "unknown-schema-id-or-digest",
              "aggregate-sequence-gap",
              "etag-mismatch"
            ]
          }
        },
        "resumeAfter": {
          "const": "exact-resource-schema-and-etag-verified"
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
