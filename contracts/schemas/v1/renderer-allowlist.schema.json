{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/renderer-allowlist/1.0.0",
  "title": "Compiled renderer release allowlist",
  "x-bytedesk-digestAuthority": { "profile": "bytedesk.renderer-allowlist-authority-digest/1", "exclude": ["contract", "schema", "authorityDigest", "signingResult"] },
  "type": "object",
  "required": ["contract", "schema", "entries", "generatedAt", "trustPolicy", "authorityDigest", "signingResult"],
  "properties": {
    "contract": { "const": "bytedesk.renderer-allowlist/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "description": "Entries must also be unique by the semantic harnessId/rendererId/version selection key; the renderer conformance validator enforces that property-level invariant.",
      "items": {
        "type": "object",
        "required": ["harnessId", "rendererId", "version", "release", "platforms"],
        "properties": {
          "harnessId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
          "rendererId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
          "version": { "type": "string", "maxLength": 128, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "release": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["linux/amd64", "linux/arm64"] }
          }
        },
        "additionalProperties": false,
        "unevaluatedProperties": false
      }
    },
    "generatedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "trustPolicy": {
      "allOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/trustPolicyRef" },
        { "properties": { "id": { "const": "product-release-v1" } }, "required": ["id"] }
      ]
    },
    "authorityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "signingResult": {
      "allOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/signing-result/1.0.0" },
        { "properties": { "purpose": { "const": "product-release-v1" }, "subjectMediaType": { "const": "application/vnd.bytedesk.agent.renderer-allowlist.v1+json" } }, "required": ["purpose", "subjectMediaType"] }
      ]
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
