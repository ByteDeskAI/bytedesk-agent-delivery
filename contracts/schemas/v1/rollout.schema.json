{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/rollout/1.0.0",
  "title": "Target-scoped runtime rollout",
  "type": "object",
  "required": ["contract", "schema", "rolloutId", "consumerId", "targetId", "candidate", "desiredRevisionDigest", "activationMode", "state", "precondition", "predecessor", "createdAt", "updatedAt"],
  "properties": {
    "contract": { "const": "bytedesk.rollout/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "rolloutId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "consumerId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "targetId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "candidate": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "desiredRevisionDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "activationMode": { "type": "string", "enum": ["isolated_candidate", "guarded_in_place"] },
    "state": { "type": "string", "enum": ["pending", "staging", "staged", "preflight_passed", "canary_running", "canary_passed", "activation_authorized", "activating", "verifying_active", "provisional_active", "promoted", "cancelled", "superseded", "failed_pre_activation", "recovery_required"] },
    "precondition": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/precondition/1.0.0" },
    "predecessor": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/predecessor/1.0.0" },
    "recoveredBy": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "createdAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "updatedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "required": ["recoveredBy"] },
      "then": { "properties": { "state": { "const": "recovery_required" } } }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
