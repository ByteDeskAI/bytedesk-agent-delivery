{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/release-qualification-policy/1.0.0",
  "title": "Closed release qualification policy",
  "x-bytedesk-digestAuthority": {
    "profile": "bytedesk.release-qualification-policy-authority-digest/1",
    "exclude": ["contract", "schema", "authorityDigest", "signingResult"]
  },
  "type": "object",
  "required": [
    "contract",
    "schema",
    "policyId",
    "qualificationSuite",
    "requiredCoverageDigest",
    "requireEveryRendererRelease",
    "requireEveryRendererPlatform",
    "allowExpiredEvidence",
    "decisionRule",
    "trustPolicy",
    "authorityDigest",
    "signingResult"
  ],
  "properties": {
    "contract": { "const": "bytedesk.release-qualification-policy/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "policyId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "qualificationSuite": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "requiredCoverageDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "requireEveryRendererRelease": { "const": true },
    "requireEveryRendererPlatform": { "const": true },
    "allowExpiredEvidence": { "const": false },
    "decisionRule": { "const": "exact_required_coverage_matrix_passes" },
    "trustPolicy": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "const": "release-qualification-policy-v1" },
        "digest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "authorityDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "signingResult": {
      "allOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/signing-result/1.0.0" },
        {
          "properties": {
            "purpose": { "const": "release-qualification-policy-v1" },
            "subjectMediaType": {
              "const": "application/vnd.bytedesk.agent.release-qualification-policy.v1+json"
            }
          },
          "required": ["purpose", "subjectMediaType"]
        }
      ]
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "A purpose-separated inline signature authenticates the policy. The verifier resolves qualificationSuite, recomputes requiredCoverageDigest over its closed role-to-subject matrix, expands every scoped requirement over the exact M release set, and requires one unexpired passing evidence object for every expected tuple and no extras."
}
