{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/deployment-receipt/1.0.0",
  "title": "Append-only deployment and promotion receipt",
  "type": "object",
  "required": ["contract", "schema", "receiptId", "consumerId", "subjectId", "installationId", "targetId", "desiredRevision", "desiredRevisionDigest", "predecessor", "release", "deployment", "source", "binding", "skills", "rendererRelease", "executedDistribution", "contractBundleDigest", "trustEvaluations", "authority", "activationAuthorization", "activationAuthorizationDigest", "canaryEvidence", "result", "recordedAt"],
  "properties": {
    "contract": { "const": "bytedesk.deployment-receipt/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "receiptId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "consumerId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "subjectId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "installationId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "targetId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "desiredRevision": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
    "desiredRevisionDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "predecessor": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/predecessor/1.0.0" },
    "release": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/consumerRuntimeReleaseDescriptor" },
    "deployment": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/consumerDeploymentDescriptor" },
    "source": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "binding": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "skills": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" } },
    "rendererRelease": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "executedDistribution": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "contractBundleDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "trustEvaluations": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" } },
    "authority": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
    "activationAuthorization": {
      "allOf": [
        { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
        {
          "properties": {
            "mediaType": { "const": "application/vnd.bytedesk.agent.activation-authorization.v1+json" },
            "trustPolicy": {
              "properties": { "id": { "const": "consumer-activation-authorization-v1" } },
              "required": ["id"]
            }
          },
          "required": ["mediaType", "trustPolicy"]
        }
      ],
      "description": "Exact descriptor for the complete target-wide signed activation authorization whose deployable graph contains this receipt's subject and deployment."
    },
    "activationAuthorizationDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
      "description": "Raw RFC 8785 JCS digest of the resolved activationAuthorization object; it must bind this subject, deployment, attempt, target slot, and generation through the signed target-wide graph."
    },
    "canaryEvidence": { "type": "array", "minItems": 2, "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" } },
    "result": { "type": "string", "enum": ["promoted", "failed_pre_activation", "recovery_required", "recovered", "operator_required"] },
    "recordedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "One append-only receipt per runtime-release deployable subject. The receipt binds the exact target-wide activation authorization and its raw digest in addition to consumer authority; promotion commits only a canonical complete receipt set exactly covering the runtime-release deployable graph."
}
