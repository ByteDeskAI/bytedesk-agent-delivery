{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/private-input-authentication-bundle/1.0.0",
  "title": "Private Input Authentication Bundle",
  "type": "object",
  "required": ["contract", "schema", "consumerId", "subjectId", "installationId", "harnessId", "targetId", "entries"],
  "properties": {
    "contract": { "const": "bytedesk.private-input-authentication-bundle/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "consumerId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "subjectId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "installationId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "harnessId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "targetId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["role", "subject", "signingResult"],
        "properties": {
          "role": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
          "subject": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" },
          "signingResult": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/artifactDescriptor" }
        },
        "additionalProperties": false,
        "unevaluatedProperties": false
      },
      "description": "One exact detached signing-result descriptor for every authority-bearing input. The signing-result object may live in a purpose-policy-permitted evidence repository distinct from the subject repository; its signed subject digest, media type, trust policy, repository, and trusted-KMS evidence are verified exactly. Roles and subject descriptors must be unique and entries must be strictly ordered by role UTF-8 bytes; these cross-item invariants are verified procedurally."
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
