{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/renderer-attempt-authority/1.0.0",
  "title": "Caller-issued fenced renderer attempt authority",
  "type": "object",
  "required": [
    "contract",
    "schema",
    "attemptId",
    "attemptFencingToken",
    "rendererSelectionDigest",
    "productReleaseStatusCheckpointDigest",
    "productReleaseStatusCheckpointAuthenticationEvidenceDigest",
    "productReleaseStatusRequestNonce",
    "rendererReleaseStatusCheckpointDigest",
    "rendererReleaseStatusCheckpointAuthenticationEvidenceDigest",
    "rendererReleaseStatusRequestNonce",
    "portableDefinitionDigest",
    "inputTreeDigest",
    "framedRequestDigest",
    "contractBundleDigest",
    "sandboxProfileDigest",
    "issuerIdentityDigest",
    "issuedAt",
    "expiresAt",
    "authorityDigest"
  ],
  "properties": {
    "contract": {
      "const": "bytedesk.renderer-attempt-authority/1"
    },
    "schema": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor"
    },
    "attemptId": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier"
    },
    "attemptFencingToken": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger"
    },
    "rendererSelectionDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "productReleaseStatusCheckpointDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "productReleaseStatusCheckpointAuthenticationEvidenceDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "productReleaseStatusRequestNonce": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonce"
    },
    "rendererReleaseStatusCheckpointDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "rendererReleaseStatusCheckpointAuthenticationEvidenceDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "rendererReleaseStatusRequestNonce": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonce"
    },
    "portableDefinitionDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "inputTreeDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "framedRequestDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
      "description": "SHA-256 of the exact bounded uint32-be-length-prefixed JCS request frame passed unchanged through Strategy, Adapter, and Sandbox."
    },
    "contractBundleDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "sandboxProfileDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256"
    },
    "issuerIdentityDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
      "description": "Digest of the independently authenticated renderer-controller workload identity that owns the current action lease."
    },
    "issuedAt": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp"
    },
    "authorityDigest": {
      "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256",
      "description": "SHA-256 of RFC 8785 JCS bytes for the exact bytedesk.renderer-attempt-authority-digest/1 preimage defined by Renderer identity v1."
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "description": "Issued by the authenticated controller holding the current action lease. Strategy, Adapter, sandbox, collector, and validation carry the object unchanged; an expired authority or stale fencing token is terminal."
}
