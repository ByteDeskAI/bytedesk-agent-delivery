{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/agent-delivery/v1/canary-evidence/1.0.0",
  "title": "Purpose-separated fresh canary evidence",
  "type": "object",
  "required": ["contract", "schema", "evidenceId", "actor", "rolloutId", "planDigest", "nonce", "candidateDigest", "desiredRevisionDigest", "releaseDigest", "deploymentDigest", "consumerId", "subjectId", "targetId", "slotId", "generation", "authorityDigest", "policyDigest", "grantSetDigest", "workloadIdentityDigest", "actorIdentity", "actorVersion", "signerPolicy", "results", "issuedAt", "expiresAt", "trace"],
  "properties": {
    "contract": { "const": "bytedesk.canary-evidence/1" },
    "schema": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/schemaDescriptor" },
    "evidenceId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "actor": { "type": "string", "enum": ["host_reconciler", "consumer_capability_verifier"] },
    "rolloutId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "planDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "nonce": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/nonce" },
    "candidateDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "desiredRevisionDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "releaseDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "deploymentDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "consumerId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "subjectId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "targetId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "slotId": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
    "generation": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/positiveSafeInteger" },
    "authorityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "policyDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "grantSetDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "workloadIdentityDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
    "actorIdentity": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "actorVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "signerPolicy": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/trustPolicyRef" },
    "results": {
      "oneOf": [
        { "$ref": "#/$defs/hostResults" },
        { "$ref": "#/$defs/capabilityRequiredResults" },
        { "$ref": "#/$defs/capabilityNotApplicableResults" }
      ]
    },
    "issuedAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/timestamp" },
    "trace": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/redactedEvidenceRef" }
  },
  "allOf": [
    {
      "if": { "properties": { "actor": { "const": "host_reconciler" } }, "required": ["actor"] },
      "then": { "properties": { "results": { "$ref": "#/$defs/hostResults" } } }
    },
    {
      "if": { "properties": { "actor": { "const": "consumer_capability_verifier" } }, "required": ["actor"] },
      "then": {
        "properties": {
          "results": {
            "oneOf": [
              { "$ref": "#/$defs/capabilityRequiredResults" },
              { "$ref": "#/$defs/capabilityNotApplicableResults" }
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "technicalResult": {
      "type": "object",
      "required": ["actual", "trace"],
      "properties": {
        "actual": { "type": "string", "enum": ["passed", "failed"] },
        "trace": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/redactedEvidenceRef" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "hostResults": {
      "type": "object",
      "required": ["artifact_readback", "file_inventory", "slot_generation", "service_process", "resource_thresholds", "harness_readiness", "switch_marker"],
      "properties": {
        "artifact_readback": { "$ref": "#/$defs/technicalResult" },
        "file_inventory": { "$ref": "#/$defs/technicalResult" },
        "slot_generation": { "$ref": "#/$defs/technicalResult" },
        "service_process": { "$ref": "#/$defs/technicalResult" },
        "resource_thresholds": { "$ref": "#/$defs/technicalResult" },
        "harness_readiness": { "$ref": "#/$defs/technicalResult" },
        "switch_marker": { "$ref": "#/$defs/technicalResult" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "workloadLoginResult": {
      "type": "object",
      "required": ["actual", "trace"],
      "properties": {
        "actual": { "type": "string", "enum": ["passed", "failed"] },
        "trace": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/redactedEvidenceRef" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "authorizationDecisionResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["outcome", "decisionClass", "decisionCode", "authorizationDecisionProofDigest"],
          "properties": {
            "outcome": { "const": "decision" },
            "decisionClass": { "type": "string", "enum": ["permitted", "policy_denied"] },
            "decisionCode": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/identifier" },
            "authorizationDecisionProofDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" }
          },
          "additionalProperties": false,
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["outcome", "failureClass"],
          "properties": {
            "outcome": { "const": "failed" },
            "failureClass": { "type": "string", "enum": ["transport_error", "timeout", "not_found", "parser_error", "unavailable"] }
          },
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      ]
    },
    "capabilityRequiredResults": {
      "type": "object",
      "required": ["mode", "workload_login", "permitted_capability", "denied_sentinel"],
      "properties": {
        "mode": { "const": "required" },
        "workload_login": { "$ref": "#/$defs/workloadLoginResult" },
        "permitted_capability": { "$ref": "#/$defs/authorizationDecisionResult" },
        "denied_sentinel": { "$ref": "#/$defs/authorizationDecisionResult" }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "capabilityNotApplicableResults": {
      "type": "object",
      "required": ["mode", "certified_not_applicable"],
      "properties": {
        "mode": { "const": "certified_not_applicable" },
        "certified_not_applicable": {
          "type": "object",
          "required": ["actual", "certificationDigest", "certificationPolicy", "trace"],
          "properties": {
            "actual": { "type": "string", "enum": ["not_applicable", "failed"] },
            "certificationDigest": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/sha256" },
            "certificationPolicy": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/trustPolicyRef" },
            "trace": { "$ref": "https://schemas.bytedesk.ai/agent-delivery/v1/common/1.0.0#/$defs/redactedEvidenceRef" }
          },
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": false,
      "unevaluatedProperties": false
    }
  },
  "description": "Actor-discriminated evidence fixes exactly seven host results or exactly the required three capability results or one certified non-applicability result. Failed transports remain failures and cannot be represented as policy denial."
}
