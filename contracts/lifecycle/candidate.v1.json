{
  "$schema": "https://schemas.bytedesk.ai/agent-delivery/v1/transition-model/1.0.0",
  "profile": "bytedesk.candidate-lifecycle/1",
  "version": 1,
  "initialStates": ["received"],
  "states": [
    {"name": "received", "terminal": false},
    {"name": "fetching", "terminal": false},
    {"name": "fetched", "terminal": false},
    {"name": "validating", "terminal": false},
    {"name": "validated", "terminal": false},
    {"name": "quarantined", "terminal": false},
    {"name": "evaluating", "terminal": false},
    {"name": "awaiting_approval", "terminal": false},
    {"name": "approved", "terminal": false},
    {"name": "compiling", "terminal": false},
    {"name": "compiled", "terminal": false},
    {"name": "signing", "terminal": false},
    {"name": "prepared", "terminal": true},
    {"name": "rejected", "terminal": true},
    {"name": "cancelled", "terminal": true},
    {"name": "superseded", "terminal": true},
    {"name": "failed", "terminal": true}
  ],
  "transitions": [
    {"name": "begin_fetch", "from": ["received"], "to": "fetching", "actor": "promotion-coordinator", "guard": "candidate_descriptor_accepted", "cas": "match", "effects": ["append_transition", "enqueue_fetch"], "event": "candidate.fetching.v1", "retryable": false},
    {"name": "complete_fetch", "from": ["fetching"], "to": "fetched", "actor": "candidate-worker", "guard": "exact_graph_fetched_and_verified", "cas": "match", "effects": ["append_transition", "append_fetch_evidence"], "event": "candidate.fetched.v1", "retryable": false},
    {"name": "begin_validation", "from": ["fetched"], "to": "validating", "actor": "promotion-coordinator", "guard": "fetch_evidence_current", "cas": "match", "effects": ["append_transition", "enqueue_validation"], "event": "candidate.validating.v1", "retryable": false},
    {"name": "complete_validation", "from": ["validating"], "to": "validated", "actor": "candidate-worker", "guard": "schema_agentspec_portability_and_safety_valid", "cas": "match", "effects": ["append_transition", "append_validation_evidence"], "event": "candidate.validated.v1", "retryable": false},
    {"name": "reject_invalid", "from": ["validating"], "to": "rejected", "actor": "candidate-worker", "guard": "deterministic_validation_denial", "cas": "match", "effects": ["append_transition", "append_redacted_problem"], "event": "candidate.rejected.v1", "retryable": false},
    {"name": "enter_quarantine", "from": ["validated"], "to": "quarantined", "actor": "promotion-coordinator", "guard": "validation_evidence_current", "cas": "match", "effects": ["append_transition", "record_quarantine"], "event": "candidate.quarantined.v1", "retryable": false},
    {"name": "begin_evaluation", "from": ["quarantined"], "to": "evaluating", "actor": "promotion-coordinator", "guard": "quarantine_recorded", "cas": "match", "effects": ["append_transition", "enqueue_evaluation"], "event": "candidate.evaluating.v1", "retryable": false},
    {"name": "require_approval", "from": ["evaluating"], "to": "awaiting_approval", "actor": "promotion-coordinator", "guard": "evaluation_passed_and_policy_requires_approval", "cas": "match", "effects": ["append_transition", "append_evaluation_evidence"], "event": "candidate.awaiting-approval.v1", "retryable": false},
    {"name": "auto_approve", "from": ["evaluating"], "to": "approved", "actor": "promotion-coordinator", "guard": "evaluation_passed_and_policy_allows_auto_approval_and_skill_digests_unchanged", "cas": "match", "effects": ["append_transition", "append_evaluation_evidence"], "event": "candidate.approved.v1", "retryable": false},
    {"name": "reject_evaluation", "from": ["evaluating"], "to": "rejected", "actor": "promotion-coordinator", "guard": "evaluation_or_policy_denial_terminal", "cas": "match", "effects": ["append_transition", "append_redacted_problem"], "event": "candidate.rejected.v1", "retryable": false},
    {"name": "approve", "from": ["awaiting_approval"], "to": "approved", "actor": "promotion-coordinator", "guard": "fresh_consumer_business_approval_verified", "cas": "match", "effects": ["append_transition", "append_approval_reference"], "event": "candidate.approved.v1", "retryable": false},
    {"name": "reject_approval", "from": ["awaiting_approval"], "to": "rejected", "actor": "promotion-coordinator", "guard": "consumer_business_approval_denied", "cas": "match", "effects": ["append_transition", "append_approval_reference"], "event": "candidate.rejected.v1", "retryable": false},
    {"name": "begin_compile", "from": ["approved"], "to": "compiling", "actor": "promotion-coordinator", "guard": "approval_and_authority_inputs_current", "cas": "match", "effects": ["append_transition", "enqueue_compile"], "event": "candidate.compiling.v1", "retryable": false},
    {"name": "complete_compile", "from": ["compiling"], "to": "compiled", "actor": "candidate-worker", "guard": "private_effective_render_and_deployment_verified", "cas": "match", "effects": ["append_transition", "append_compile_evidence"], "event": "candidate.compiled.v1", "retryable": false},
    {"name": "begin_sign", "from": ["compiled"], "to": "signing", "actor": "promotion-coordinator", "guard": "compile_evidence_and_consumer_deployment_authority_current", "cas": "match", "effects": ["append_transition", "enqueue_sign"], "event": "candidate.signing.v1", "retryable": false},
    {"name": "complete_sign", "from": ["signing"], "to": "prepared", "actor": "candidate-worker", "guard": "signature_and_dual_region_publication_verified", "cas": "match", "effects": ["append_transition", "append_publication_evidence"], "event": "candidate.prepared.v1", "retryable": false},
    {"name": "cancel", "from": ["received", "fetching", "fetched", "validating", "validated", "quarantined", "evaluating", "awaiting_approval", "approved", "compiling", "compiled"], "to": "cancelled", "actor": "promotion-coordinator", "guard": "consumer_cancel_authorized_and_signing_not_started", "cas": "match", "effects": ["append_transition", "cancel_uncommitted_actions"], "event": "candidate.cancelled.v1", "retryable": false},
    {"name": "supersede", "from": ["received", "fetching", "fetched", "validating", "validated", "quarantined", "evaluating", "awaiting_approval", "approved", "compiling", "compiled"], "to": "superseded", "actor": "promotion-coordinator", "guard": "newer_candidate_selected_and_no_publication_or_rollout_side_effect", "cas": "match", "effects": ["append_transition", "link_replacement_candidate", "cancel_uncommitted_actions"], "event": "candidate.superseded.v1", "retryable": false},
    {"name": "attempts_exhausted", "from": ["received", "fetching", "fetched", "validating", "validated", "quarantined", "evaluating", "awaiting_approval", "approved", "compiling", "compiled", "signing"], "to": "failed", "actor": "candidate-worker", "guard": "retry_budget_exhausted_or_nonretryable_dependency_failure", "cas": "match", "effects": ["append_transition", "append_redacted_problem", "dead_letter_side_effecting_attempts"], "event": "candidate.failed.v1", "retryable": false}
  ]
}
